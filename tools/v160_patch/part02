        old_offset = int(row["offset"])
        same_snapshot = (
            same_identity
            and old_size == int(st.st_size)
            and int(row["mtime_ns"]) == int(st.st_mtime_ns)
            and old_offset >= int(st.st_size)
        )
        if same_snapshot:
            stats.cache_hits += 1
            return

        append_only = same_identity and int(st.st_size) >= old_size
        if int(st.st_size) == old_size and int(st.st_mtime_ns) != int(row["mtime_ns"]):
            append_only = False
        if append_only:
            start_offset = min(old_offset, int(st.st_size))
            current_model = str(row["current_model"] or "unknown")
            current_service_tier = str(row["current_service_tier"] or SERVICE_TIER_UNKNOWN)
            own_meta_seen = bool(row["own_meta_seen"])
            session = _session_from_cache_row(row, path)
            stats.incremental_scans += 1
        else:
            reset = True
    else:
        session = RawSession(session_id=id_from_filename(path), path=path)
        stats.cold_scans += 1

    if reset:
        conn.execute("DELETE FROM events WHERE path=?", (p,))
        conn.execute("DELETE FROM files WHERE path=?", (p,))
        session = RawSession(session_id=id_from_filename(path), path=path)
        start_offset = 0
        current_model = "unknown"
        current_service_tier = SERVICE_TIER_UNKNOWN
        own_meta_seen = False
        if row is not None:
            stats.cold_scans += 1

    last_complete_offset = start_offset
    try:
        fh = path.open("rb", buffering=4 * 1024 * 1024)
    except OSError:
        return

    with fh:
        fh.seek(start_offset)
        while True:
            line_start = fh.tell()
            raw = fh.readline()
            if not raw:
                break
            stats.bytes_read += len(raw)
            if not raw.endswith(b"\n"):
                break
            last_complete_offset = fh.tell()
            if not raw.startswith(b"{") or not _line_is_relevant(raw):
                continue
            try:
                rec = json.loads(raw)
            except (json.JSONDecodeError, UnicodeDecodeError, MemoryError):
                session.malformed_lines += 1
                continue
            stats.parsed_records += 1
            current_model, current_service_tier, own_meta_seen, event = _apply_record(
                session, rec, current_model, current_service_tier, own_meta_seen
            )
            if event is not None:
                u = event.cumulative
                conn.execute(
                    """
                    INSERT OR REPLACE INTO events(
                        path,byte_offset,ts,model,service_tier,input_tokens,cached_input_tokens,
                        output_tokens,reasoning_output_tokens,total_tokens
