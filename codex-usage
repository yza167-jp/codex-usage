@dataclass(frozen=True)
class Usage:
    input_tokens: int = 0
    cached_input_tokens: int = 0
    output_tokens: int = 0
    reasoning_output_tokens: int = 0
    total_tokens: int = 0

    @classmethod
    def from_dict(cls, d: dict) -> "Usage":
        def n(key: str) -> int:
            try:
                return max(0, int(d.get(key, 0) or 0))
            except (TypeError, ValueError):
                return 0

        return cls(
            input_tokens=n("input_tokens"),
            cached_input_tokens=n("cached_input_tokens"),
            output_tokens=n("output_tokens"),
            reasoning_output_tokens=n("reasoning_output_tokens"),
            total_tokens=n("total_tokens"),
        )

    def key(self) -> Tuple[int, int, int, int, int]:
        return (
            self.input_tokens,
            self.cached_input_tokens,
            self.output_tokens,
            self.reasoning_output_tokens,
            self.total_tokens,
        )

    def minus(self, prev: "Usage") -> "Usage":
        # Normal case: cumulative counters only increase.
        vals = {}
        reset = any(
            getattr(self, f) < getattr(prev, f)
            for f in ("input_tokens", "cached_input_tokens", "output_tokens")
        )
        for f in CORE_FIELDS:
            cur = getattr(self, f)
            old = getattr(prev, f)
            vals[f] = cur if reset else max(0, cur - old)
        return Usage(**vals)

    def __add__(self, other: "Usage") -> "Usage":
        return Usage(**{
            f: getattr(self, f) + getattr(other, f)
            for f in CORE_FIELDS
        })

    def nonzero(self) -> bool:
        return any(
            getattr(self, f) > 0
            for f in ("input_tokens", "cached_input_tokens", "output_tokens")
        )


