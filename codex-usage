    items = [pretty_model(m) for m in model_names(models)]
    return " / ".join(items) if items else "?"


def service_tier_display(tier: str, compact: bool = False) -> str:
    mapping = {
        SERVICE_TIER_STANDARD: "STD" if compact else "Standard",
        SERVICE_TIER_FAST: "FAST" if compact else "Fast",
        SERVICE_TIER_FLEX: "FLEX" if compact else "Flex",
        SERVICE_TIER_UNKNOWN: "?" if compact else "Unknown",
    }
    return mapping.get(tier, "?" if compact else tier.title())


def service_tiers(models: Iterable[str]) -> List[str]:
    found = set()
    for key in models:
        _, tier = split_usage_key(key)
        found.add(tier)
    return [tier for tier in SERVICE_TIER_ORDER if tier in found]


def tier_label(models: Iterable[str]) -> str:
    tiers = service_tiers(models)
    if not tiers:
        return "?"
    if tiers == [SERVICE_TIER_FAST, SERVICE_TIER_STANDARD]:
        return "MIXED"
    return "/".join(service_tier_display(t, compact=True) for t in tiers)


def group_by_service_tier(usage_by_model: Dict[str, Usage]) -> Dict[str, Dict[str, Usage]]:
    grouped: Dict[str, Dict[str, Usage]] = {}
    for key, usage in usage_by_model.items():
        _, tier = split_usage_key(key)
        target = grouped.setdefault(tier, {})
        target[key] = target.get(key, Usage()) + usage
    return grouped


def _terminal_char_width(ch: str) -> int:
    """Approximate the number of terminal cells occupied by one Unicode code point.

    The standard library has no full wcwidth implementation, but East Asian
    Width plus Unicode categories covers the important table-layout cases:
    CJK wide/fullwidth characters use two cells; combining/format characters
    use zero; ordinary characters use one. Ambiguous-width characters stay at
    one cell, matching modern terminals in their default locale behavior.
    """
    if not ch:
        return 0
    category = unicodedata.category(ch)
    if category in ("Mn", "Me", "Cf"):
        return 0
    # C0/C1 controls should never be used to advance a table cursor estimate.
    if category == "Cc":
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def display_width(s: str) -> int:
    """Return terminal display width in cells, not Python code-point length."""
    return sum(_terminal_char_width(ch) for ch in s)


def truncate(s: str, width: int) -> str:
    """Truncate to at most ``width`` terminal cells, preserving Unicode marks."""
    if width <= 0:
        return ""
    if display_width(s) <= width:
        return s

    ellipsis = "…"
    ellipsis_width = display_width(ellipsis)
    if width <= ellipsis_width:
        return ellipsis if width == ellipsis_width else ""

    budget = width - ellipsis_width
    out = []
    used = 0
    for ch in s:
        cell_width = _terminal_char_width(ch)
        if cell_width == 0:
            # Keep marks/format characters only when they can attach to content
            # already emitted; avoid returning a leading orphan mark.
            if out:
                out.append(ch)
            continue
        if used + cell_width > budget:
            break
        out.append(ch)
        used += cell_width
    return "".join(out).rstrip("\u200d") + ellipsis


def wrap_display_words(text: str, width: int) -> List[str]:
    """Wrap plain text at terminal-cell boundaries without dropping long IDs.

    Prefer word boundaries. A single overlong model ID is split only when
    necessary; zero-width combining marks stay with the preceding character.
    """
    if width < 2:
        raise ValueError("display wrapping requires at least two terminal cells")
    lines: List[str] = []
    current = ""
    used = 0
    for word in text.split():
        word_width = display_width(word)
        if current and used + 1 + word_width <= width:
            current += " " + word
            used += 1 + word_width
            continue
        if current:
            lines.append(current)
            current, used = "", 0
        for ch in word:
            cells = _terminal_char_width(ch)
            if used + cells > width:
                lines.append(current)
                current, used = "", 0
            current += ch
            used += cells
    if current:
        lines.append(current)
    return lines


def model_cell_layout(
    models: Iterable[str], column_width: int, report_width: int,
) -> Tuple[str, List[str]]:
    """Keep full model names available without widening the summary table.

    A fitting list stays inline. Overflow uses a complete first model +N (or
    a model count) and a losslessly wrapped continuation list under that row.
    Model/tier keys are deduplicated by model, just like the existing label.
    """
    names = model_names(models)
    full = model_label(names)
    if display_width(full) <= column_width:
        return full, []

    count = len(names)
    compact = f"{pretty_model(names[0])} +{count - 1}" if count > 1 else "1 model"
    if display_width(compact) > column_width:
        compact = f"{count} models" if count > 1 else "1 model"
    # Only the count may be clipped on an extremely narrow caller. The full
    # model list is never ellipsized, including unknown/long model IDs.
    compact = truncate(compact, column_width)
    prefix = "  Models: "
    wrapped = wrap_display_words(full, max(2, report_width - display_width(prefix)))
    continuation = " " * display_width(prefix)
    return compact, [
        (prefix if i == 0 else continuation) + part
        for i, part in enumerate(wrapped)
    ]


def pad_display(s: str, width: int, right: bool = False) -> str:
    """Truncate and pad a table cell using terminal-cell width."""
    clipped = truncate(s, width)
    padding = max(0, width - display_width(clipped))
    spaces = " " * padding
    return spaces + clipped if right else clipped + spaces


def fit_widths_to_target(
    base_widths: Iterable[int],
    target_width: int,
    flexible_indexes: Iterable[int],
    gap: int = 2,
) -> List[int]:
    """Expand textual columns so a table shares a stable right edge."""
    widths = list(base_widths)
    flex = list(flexible_indexes)
    if not widths or not flex:
        return widths
    current = sum(widths) + gap * (len(widths) - 1)
    extra = target_width - current
    if extra <= 0:
        return widths
    share, remainder = divmod(extra, len(flex))
    for pos, idx in enumerate(flex):
        widths[idx] += share + (1 if pos < remainder else 0)
    return widths


def shrink_widths_to_target(
    base_widths: Iterable[int],
    minimum_widths: Iterable[int],
    target_width: int,
    shrink_order: Iterable[int],
    gap: int = 2,
) -> List[int]:
    """Shrink selected columns without sacrificing the SESSION column first."""
    widths = list(base_widths)
    minimums = list(minimum_widths)
    if len(widths) != len(minimums):
        raise ValueError("base_widths and minimum_widths must have equal length")
    deficit = sum(widths) + gap * (len(widths) - 1) - target_width
    for idx in shrink_order:
        if deficit <= 0:
            break
        reducible = max(0, widths[idx] - minimums[idx])
        cut = min(reducible, deficit)
        widths[idx] -= cut
        deficit -= cut
    return widths


def human_tokens_compact(n: int) -> str:
    """Compact token count for the inline INPUT/CACHED/OUTPUT triplet."""
    value = max(0, int(n))
    for scale, suffix in (
        (1_000_000_000_000, "T"),
        (1_000_000_000, "B"),
        (1_000_000, "M"),
        (1_000, "K"),
    ):
        if value >= scale:
            scaled = value / scale
            if scaled >= 100:
                return f"{scaled:.0f}{suffix}"
            if scaled >= 10:
                text = f"{scaled:.1f}"
            else:
                text = f"{scaled:.2f}"
            return text.rstrip("0").rstrip(".") + suffix
    return str(value)


def token_triplet_text(usage: Usage) -> str:
    """Render INPUT/CACHED/OUTPUT compactly while retaining all three values."""
    return "/".join((
        human_tokens_compact(usage.input_tokens),
        human_tokens_compact(usage.cached_input_tokens),
        human_tokens_compact(usage.output_tokens),
    ))


def fit_session_summary_title(title: str, width: int) -> str:
    """Keep both project context and task text visible in a narrow SESSION cell.

    A generic right-side truncation can spend the entire cell on a long prefix
    such as ``[atomic-cross-modal-transfer]``. This renderer reserves part of
    the cell for the actual Codex name/title and shortens the project tag first.
    """
    clean = _clean_thread_label(title)
    if width <= 0 or display_width(clean) <= width:
        return clean if width > 0 else ""
    match = re.match(r"^\[([^\]]+)\]\s*(.*)$", clean)
    if not match or not match.group(2):
        return truncate(clean, width)

    context, body = match.group(1), match.group(2)
    body_reserve = min(14, max(8, width // 3))
    marker = re.match(r"^(#[^\s]+)\s+", body)
    if marker:
        body_reserve = max(
            body_reserve,
            min(max(8, width - 6), display_width(marker.group(1)) + 5),
        )
    context_budget = max(3, width - body_reserve - 3)  # brackets + separating space
    context_text = truncate(context, context_budget)
    prefix = f"[{context_text}] "
    remaining = width - display_width(prefix)
    if remaining < 4:
        return truncate(clean, width)
    return prefix + truncate(body, remaining)


def session_without_project(title: str, project: str) -> str:
    """Remove only a known project prefix, never arbitrary bracketed task tags."""
    clean = _clean_thread_label(title)
    project = _clean_thread_label(project)
    orphan = "[ORPHAN SUB] "
    if clean.startswith(orphan):
        return orphan + session_without_project(clean[len(orphan):], project)
    if project:
        for prefix in (f"[{project}]", project + " ·", project + ":"):
            if clean.casefold().startswith(prefix.casefold()):
                rest = clean[len(prefix):].lstrip()
                if rest:
                    return rest
    return clean


def bucket_identity(bucket: Bucket) -> Tuple[str, str]:
    """Return independent project and session labels from structured metadata."""
    project = _clean_thread_label(bucket.project_name) or _cwd_project_label(bucket.cwd)
    title = session_without_project(bucket.title, project)
    if not title or (title == project and not bucket.session_name and not bucket.thread_title):
        title = short_sid(bucket.session_id)
    return project, title


def summary_column_gap(terminal_width: int) -> int:
    return 1 if terminal_width < REPORT_MAX_WIDTH else 2


def summary_table_layout(
    terminal_width: int,
    wide: bool,
) -> Tuple[List[str], List[int], set, bool]:
    """Reserve separate PROJECT/SESSION columns, including in --wide mode.

    At 144 cells the identity columns get 18 and 33 cells. Token diagnostics
    use continuation lines instead of taking those cells back from the names.
    The final bool retains the renderer contract (tokens are not inline).
    """
    terminal_width = max(80, min(REPORT_MAX_WIDTH, terminal_width))
    gap = summary_column_gap(terminal_width)
    headers = [
        "PROJECT", "SESSION", "MODEL(S)", "TIER(S)", "WEEKLY≈", "1H≈",
        "CREDITS*", "CACHE TAX", "SHARE", "STATUS",
    ]
    base = [18, 33, 12, 9, 9, 8, 9, 9, 6, 13]
    minimums = [7, 12, 8, 5, 6, 5, 7, 7, 5, 7]
    readable = list(base)
    readable[0], readable[1] = 12, 22
    widths = shrink_widths_to_target(base, readable, terminal_width, (1, 0), gap)
    widths = shrink_widths_to_target(
        widths, minimums, terminal_width, (2, 3, 9, 4, 5, 6, 7, 8, 0, 1), gap,
    )
    widths = fit_widths_to_target(widths, terminal_width, (1,), gap)
    return headers, widths, {4, 5, 6, 7, 8}, False


def make_buckets(
    sessions: Dict[str, RawSession],
    index: Dict[str, dict],
    start: datetime,
    end: datetime,
    tz,
    show_subagents: bool,
    trend_start: Optional[datetime] = None,
) -> Dict[str, Bucket]:
    buckets: Dict[str, Bucket] = {}

    for session in sessions.values():
        deltas = compute_deltas(session, sessions)
        if not deltas:
            continue

        target_id = rollup_target(session, sessions, show_subagents)
        target_session = sessions.get(target_id, session)

        bucket = buckets.get(target_id)
        if bucket is None:
            dbrow = index.get(target_id, {})
            label_meta = session_label_metadata(target_session, index)
            title = label_meta["display_title"]
            if show_subagents and target_session.is_subagent():
                title += f" [sub {short_sid(target_session.session_id)}]"
            elif (
                not show_subagents
                and target_session.is_subagent()
                and (not target_session.lineage_parent() or target_session.lineage_parent() not in sessions)
            ):
                title = "[ORPHAN SUB] " + title
            bucket = Bucket(
                session_id=target_id,
                title=title,
                cwd=str(dbrow.get("cwd") or target_session.cwd or ""),
                source=str(dbrow.get("source") or target_session.source or ""),
                session_name=label_meta["session_name"],
                thread_title=label_meta["thread_title"],
                project_id=label_meta["project_id"],
                project_name=label_meta["project_name"],
            )
            buckets[target_id] = bucket

        source_meta = session_label_metadata(session, index)
        bucket.source_projects[session.session_id] = source_meta["project_name"]
        for ts, model, service_tier, delta in deltas:
            local_ts = _to_tz(ts, tz)
            if start <= local_ts < end:
                bucket.add(
                    model,
                    delta,
                    session.session_id,
                    source_title=source_meta["display_title"],
                    is_subagent=session.is_subagent(),
                    activity_ts=local_ts,
                    recent=(trend_start is not None and local_ts >= trend_start),
                    service_tier=service_tier,
                )

    visible = {sid: b for sid, b in buckets.items() if b.total_usage().nonzero()}
    _disambiguate_bucket_titles(visible)
    return visible


def render_table(
    buckets: Dict[str, Bucket],
    sessions: Dict[str, RawSession],
    period_label: str,
    tz,
    fast: bool,
    details: bool,
    now: datetime,
    live_report: bool,
    color: Colorizer,
    wide: bool = False,
    top_agents: int = 8,
    all_agents: bool = False,
    auth_context: Optional[LocalAuthContext] = None,
    quota_snapshot: Optional[QuotaSnapshot] = None,
    quota_calibration: Optional[QuotaCalibration] = None,
    quota_local_credits: Optional[float] = None,
    quota_local_complete: bool = True,
) -> str:
    rows = []
    known_credit_total = 0.0
    any_partial = False
    all_credit_complete = True

    for b in buckets.values():
        u = b.total_usage()
        credits, complete = bucket_credits(b, sessions, fast)
        _, cache_tax, _, _ = cost_components_for_map(b.usage_by_model, fast)
        state = thread_state(b, now, live_report)
        health = effective_health(b, fast, state)
        burn, recent_cache, burn_complete = recent_burn(b, fast)
        is_orphan = orphan_subagent(b, sessions)
        if credits is not None:
            known_credit_total += credits
        if not complete:
            any_partial = True
            all_credit_complete = False
        rows.append((b, u, credits, complete, cache_tax, state, health, burn, recent_cache, burn_complete, is_orphan))

    rows.sort(
        key=lambda x: (
            0 if x[5] == "ACTIVE" else 1 if x[5] == "RECENT" else 2,
            -(x[2] if x[2] is not None else -1.0),
        )
    )

    lines: List[str] = []
    terminal_width = max(80, min(REPORT_MAX_WIDTH, shutil.get_terminal_size(fallback=(120, 24)).columns))
    tzname = _tz_display(tz, now)
    mode = "Tier-aware credits (unknown→Fast)" if fast else "Tier-aware credits"
    lines.append(color.wrap(f"Codex usage — {period_label} — {tzname}", color.BOLD, color.CYAN))
    lines.append(color.wrap(
        f"Credit mode: {mode} (rate card {RATE_CARD_AS_OF}; GPT-6 {GPT6_RATE_CARD_AS_OF})",
        color.DIM,
    ))

    plan_raw = ""
    if quota_snapshot is not None and quota_snapshot.plan_type:
        plan_raw = quota_snapshot.plan_type
    elif auth_context is not None:
        plan_raw = auth_context.plan_type
    if quota_snapshot is not None:
        used = quota_snapshot.used_percent
        left = max(0.0, 100.0 - used)
        sub_line = (
            f"Subscription  {plan_display_name(plan_raw)} · CURRENT WEEK {used:.1f}% used / {left:.1f}% left "
            f"· reset {human_until(quota_snapshot.resets_at, now)} · snapshot {human_age(quota_snapshot.ts, now)}"
        )
        sub_style = color.RED if used >= 85 else color.YELLOW if used >= 60 else color.GREEN
        lines.append(color.wrap(truncate(sub_line, terminal_width), color.BOLD, sub_style))
        if quota_calibration is not None and quota_calibration.credits_per_percent:
            cal = quota_calibration
            coverage = (
                f" · local coverage≈{cal.local_coverage_percent:.0f}%"
                if cal.local_coverage_percent is not None else ""
            )
            if cal.source == "delta":
                cal_meta = f" · {cal.clean_intervals} clean / {cal.observed_percent_points:.1f}pp"
            elif cal.source == "rebased_baseline":
                cal_meta = " · rebased baseline"
            elif cal.source == "historical_rebased":
                cal_meta = " · historical rebase"
            elif cal.source == "historical_baseline":
                cal_meta = " · historical baseline"
            elif cal.source == "stored_baseline":
                cal_meta = " · stored baseline"
            elif cal.source in ("plan_seed", "generic_seed"):
                cal_meta = " · plan bootstrap"
            else:
                cal_meta = " · baseline"
            scale_line = (
                f"Weekly scale  1% ≈ {cal.credits_per_percent:.1f} credits* · {cal.confidence}"
                f"{cal_meta}{coverage}"
            )
            lines.append(color.wrap(truncate(scale_line, terminal_width), color.DIM))
            if quota_local_credits is not None:
                local_week = weekly_percent_text(quota_local_credits, cal, quota_local_complete)
                credit_mark = f"{quota_local_credits:.1f}" + ("" if quota_local_complete else "+")
            elif not quota_local_complete:
                local_week = "≥0.00%"
                credit_mark = "0.0+"
            else:
                local_week = "0.00%"
                credit_mark = "0.0"
            lines.append(color.wrap(
                truncate(f"Local this week≈ {local_week} · CREDITS* {credit_mark}", terminal_width),
                color.DIM,
            ))
    elif plan_raw:
        lines.append(color.wrap(
            truncate(f"Subscription  {plan_display_name(plan_raw)} · WEEKLY snapshot unavailable in recent rollout telemetry", terminal_width),
            color.DIM,
        ))
    lines.append("")

    if not rows:
        lines.append("No token_count usage found for this period.")
        return "\n".join(lines)

    gap = 2
    headers, widths, align_right, wide_inline = summary_table_layout(
        terminal_width, wide
    )
    summary_separator = " " * summary_column_gap(terminal_width)

    def styled_cell(padded: str, style: Optional[str]) -> str:
        if not style:
            return padded
        styles = {
            "header": (color.BOLD, color.CYAN),
            "active": (color.BOLD, color.GREEN),
            "recent": (color.CYAN,),
            "idle": (color.DIM,),
            "ok": (color.GREEN,),
            "watch": (color.BOLD, color.YELLOW),
            "rotate": (color.BOLD, color.RED),
            "orphan": (color.BOLD, color.MAGENTA),
            "warn": (color.YELLOW,),
            "hot": (color.BOLD, color.RED),
            "total": (color.BOLD, color.CYAN),
            "dim": (color.DIM,),
            "section": (color.BOLD, color.BLUE),
        }.get(style, ())
        return color.wrap(padded, *styles)

    def fmt_row(row, styles=None, custom_widths=None, custom_right=None):
        use_widths = custom_widths or widths
        use_right = align_right if custom_right is None else custom_right
        styles = styles or {}
        cells = []
        for i, (cell, width) in enumerate(zip(row, use_widths)):
            padded = pad_display(str(cell), width, right=(i in use_right))
            cells.append(styled_cell(padded, styles.get(i)))
        return summary_separator.join(cells)

    lines.append(fmt_row(headers, {i: "header" for i in range(len(headers))}))
    lines.append(color.wrap(summary_separator.join("-" * w for w in widths), color.DIM))

    for b, u, credits, complete, cache_tax, state, health, burn, recent_cache, burn_complete, is_orphan in rows:
        credit_text = "—"
        share_text = "—"
        if credits is not None:
            credit_text = f"{credits:.1f}" + ("" if complete else "+")
            if known_credit_total > 0:
                share_text = f"{100.0 * credits / known_credit_total:.1f}%"
        project, session_name = bucket_identity(b)
        raw_title = session_name + (f" (+{len(b.child_sessions)} sub)" if b.child_sessions else "")
        title = truncate(raw_title, widths[1])
        status = status_text(state, health, is_orphan)
        weekly_text = weekly_percent_text(credits, quota_calibration, complete)
        burn_weekly = weekly_percent_text(
            burn if burn is not None and burn > 0 else None, quota_calibration, burn_complete
        )

        model_text, model_lines = model_cell_layout(
            b.usage_by_model.keys(), widths[2], terminal_width
        )
        row = [
            project or "—", title, model_text, tier_label(b.usage_by_model.keys()),
            weekly_text, burn_weekly, credit_text,
            f"{cache_tax:.1f}" if cache_tax > 0 else "—", share_text, status,
        ]
        status_idx, title_idx, burn_idx, cache_idx = 9, 1, 5, 7

        styles = {}
        if is_orphan:
            styles[status_idx] = "orphan"
            styles[title_idx] = "orphan"
        elif state in ("ACTIVE", "RECENT") and health == "ROTATE":
            styles[title_idx] = "rotate"
        elif state in ("ACTIVE", "RECENT") and health == "WATCH":
            styles[title_idx] = "watch"
        elif state in ("ACTIVE", "RECENT") and health == "OK":
            styles[title_idx] = "ok" if state == "ACTIVE" else "recent"
        else:
            styles[title_idx] = "idle"

        if health == "ROTATE":
            styles[status_idx] = "rotate"
        elif health == "WATCH":
            styles[status_idx] = "watch"
        elif health == "OK" and state in ("ACTIVE", "RECENT"):
            styles[status_idx] = "ok"
        elif not is_orphan:
            styles[status_idx] = "idle"

        if credits and cache_tax / credits >= 0.70:
            styles[cache_idx] = "warn"
        if burn is not None:
            if burn >= 500:
                styles[burn_idx] = "hot"
            elif burn >= 100:
                styles[burn_idx] = "warn"

        styles[0] = "idle" if state == "IDLE" else "recent"
        lines.append(fmt_row(row, styles))
        lines.extend(color.wrap(line, color.DIM) for line in model_lines)
        if wide and not wide_inline:
            token_line = f"  TOKENS I/C/O  {token_triplet_text(u)}"
            lines.append(color.wrap(truncate(token_line, terminal_width), color.DIM))

    total_usage = Usage()
    total_cache_tax = 0.0
    total_recent = 0.0
    for _, u, _, _, cache_tax, _, _, burn, _, _, _ in rows:
        total_usage = total_usage + u
        total_cache_tax += cache_tax
        if burn is not None:
            total_recent += burn
    total_credit_text = f"{known_credit_total:.1f}" + ("" if all_credit_complete else "+") if known_credit_total > 0 else "—"
    total_weekly_text = weekly_percent_text(
        known_credit_total if known_credit_total > 0 else None, quota_calibration, all_credit_complete
    )
    total_burn_complete = all(r[9] for r in rows if r[7] is not None and r[7] > 0)
    total_burn_weekly = weekly_percent_text(
        total_recent if total_recent > 0 else None, quota_calibration, total_burn_complete
    )
    total_row = [
        "TOTAL", "", "", "", total_weekly_text, total_burn_weekly, total_credit_text,
        f"{total_cache_tax:.1f}" if total_cache_tax else "—",
        "100%" if known_credit_total > 0 else "—", "",
    ]
    lines.append(color.wrap(summary_separator.join("-" * w for w in widths), color.DIM))
    lines.append(fmt_row(total_row, {i: "total" for i in range(len(total_row))}))
    if wide and not wide_inline:
        lines.append(color.wrap(
            truncate(f"  TOKENS I/C/O  {token_triplet_text(total_usage)}", terminal_width),
            color.DIM,
        ))
    lines.append("")
    lines.append(color.wrap(
        "* WEEKLY≈ expresses the selected local usage as a share of one plan weekly allowance; it can span quota resets.",
        color.DIM,
    ))
    lines.append(color.wrap(
        "  1H≈ is the same weekly-equivalent metric for the trailing 60 minutes. CREDITS* and CACHE TAX are secondary diagnostics.",
        color.DIM,
    ))
    lines.append(color.wrap(STATUS_NOTE, color.DIM))
    if not wide:
        lines.append(color.wrap("  Use --wide to add a compact INPUT/CACHED/OUTPUT token triplet.", color.DIM))
    elif not wide_inline:
        lines.append(color.wrap(
            "  --wide token diagnostics use continuation lines to keep PROJECT and SESSION readable.",
            color.DIM,
        ))
    else:
        lines.append(color.wrap("  TOKENS I/C/O = INPUT / CACHED / OUTPUT.", color.DIM))
    if fast:
        lines.append(color.wrap(
            "  --fast resolves only UNKNOWN tier segments as Fast; detected Standard/Fast segments are unchanged.",
            color.DIM,
        ))
    if any_partial:
        lines.append(color.wrap(
            "  '+' means the row contains an unpriced model or unresolved/Flex tier; WEEKLY≈ with ≥ is a conservative lower bound.",
            color.DIM,
        ))

    if details:
        for b, total_u, total_credits, total_complete, total_cache_tax, state, health, burn, recent_cache, burn_complete, is_orphan in rows:
            lines.append("")
            detail_width = terminal_width
            lines.append(color.wrap("=" * detail_width, color.BLUE))
            if is_orphan:
                title_style = (color.BOLD, color.MAGENTA)
            elif health == "ROTATE" and state in ("ACTIVE", "RECENT"):
                title_style = (color.BOLD, color.RED)
            elif health == "WATCH" and state in ("ACTIVE", "RECENT"):
                title_style = (color.BOLD, color.YELLOW)
            elif health == "OK" and state == "ACTIVE":
                title_style = (color.BOLD, color.GREEN)
            else:
                title_style = (color.BOLD, color.CYAN) if state == "RECENT" else (color.DIM,)
            project, session_name = bucket_identity(b)
            short_title = truncate(session_name, max(30, detail_width - 9))
            lines.append(color.wrap(f"DETAILS  {short_title}", *title_style))
            lines.append(f"session: {b.session_id}")
            if project:
                for i, part in enumerate(wrap_display_words(project, detail_width - 9)):
                    lines.append(("project: " if i == 0 else " " * 9) + part)
            if b.session_name:
                lines.append(f"Codex name: {b.session_name}")
            if b.thread_title and b.thread_title != b.session_name:
                lines.append(
                    "thread title: " + truncate(
                        b.thread_title, max(30, detail_width - display_width("thread title: "))
                    )
                )
            if b.cwd:
                lines.append(f"cwd: {b.cwd}")
            if b.child_sessions:
                lines.append(f"subagents in window: {len(b.child_sessions)}")
            if is_orphan:
                lines.append(color.wrap(
                    "lineage: ORPHAN SUBAGENT (parent unavailable/unresolved locally)",
                    color.BOLD, color.MAGENTA,
                ))

            state_style = 'active' if state == 'ACTIVE' else 'recent' if state == 'RECENT' else 'idle'
            state_text = styled_cell(state, state_style).strip()
            health_text = "—"
            if health != "—":
                hstyle = "rotate" if health == "ROTATE" else "watch" if health == "WATCH" else "ok"
                health_text = styled_cell(health, hstyle).strip()
            lines.append(
                f"{state_text} · last {human_age(b.last_activity, now)} · health {health_text}"
            )
            lines.append(f"Service tier  {tier_label(b.usage_by_model.keys())}")

            usage_weekly = weekly_percent_text(total_credits, quota_calibration, total_complete)
            credit_mark = "—" if total_credits is None else f"{total_credits:.1f}" + ("" if total_complete else "+")
            lines.append(f"Usage      WEEKLY≈ {usage_weekly} · CREDITS* {credit_mark}")
            if burn is not None and burn > 0:
                burn_weekly = weekly_percent_text(burn, quota_calibration, burn_complete)
                projection_weekly = weekly_percent_text(burn * 2.0, quota_calibration, burn_complete)
                projection_text = f" · +2h≈{projection_weekly}" if state == "ACTIVE" else ""
                lines.append(
                    f"1H usage   WEEKLY≈ {burn_weekly} · CREDITS* {burn:.1f} · cache {recent_cache:.1f}{projection_text}"
                )
            lines.append("")

            def fmt_detail(row, widths_, right_, styles=None):
                styles = styles or {}
                cells = []
                for i, (cell, width) in enumerate(zip(row, widths_)):
                    padded = pad_display(str(cell), width, right=(i in right_))
                    cells.append(styled_cell(padded, styles.get(i)))
                return "  ".join(cells)

            # SERVICE TIER BREAKDOWN
            lines.append(color.wrap("Service tier breakdown", color.BOLD, color.BLUE))
            th = ["SERVICE TIER", "WEEKLY≈", "CREDITS*", "SESSION%"]
            tw = fit_widths_to_target([30, 12, 12, 10], detail_width, (0,))
            tr = {1, 2, 3}
            lines.append(fmt_detail(th, tw, tr, {i: "header" for i in range(len(th))}))
            lines.append(color.wrap("  ".join("-" * w for w in tw), color.DIM))
            tier_groups = group_by_service_tier(b.usage_by_model)
            for tier in SERVICE_TIER_ORDER:
                tier_map = tier_groups.get(tier)
                if not tier_map:
                    continue
                tier_cost, tier_complete = model_map_credits(tier_map, fast)
                pct = (
                    f"{100.0 * tier_cost / total_credits:.1f}%"
                    if tier_cost is not None and total_credits not in (None, 0)
                    else "—"
                )
                tier_credit = "—" if tier_cost is None else f"{tier_cost:.1f}" + ("" if tier_complete else "+")
                lines.append(fmt_detail([
                    service_tier_display(tier),
                    weekly_percent_text(tier_cost, quota_calibration, tier_complete),
                    tier_credit,
                    pct,
                ], tw, tr, {0: "warn"} if tier in (SERVICE_TIER_FAST, SERVICE_TIER_UNKNOWN) else {}))

            lines.append("")
            # COST COMPONENTS
            uncached_c, cached_c, output_c, comp_complete = cost_components_for_map(b.usage_by_model, fast)
            component_total = uncached_c + cached_c + output_c
            lines.append(color.wrap("Usage components", color.BOLD, color.BLUE))
            ch = ["COMPONENT", "WEEKLY≈", "CREDITS*", "SESSION%"]
            cw = fit_widths_to_target([30, 12, 12, 10], detail_width, (0,))
            cr = {1, 2, 3}
            lines.append(fmt_detail(ch, cw, cr, {i: "header" for i in range(len(ch))}))
            lines.append(color.wrap("  ".join("-" * w for w in cw), color.DIM))
            for name, value in (
                ("Cached input (CACHE TAX)", cached_c),
                ("Uncached input", uncached_c),
                ("Output", output_c),
            ):
                pct = f"{100.0 * value / component_total:.1f}%" if component_total > 0 else "—"
                weekly = weekly_percent_text(value, quota_calibration, comp_complete)
                st = {0: "warn"} if name.startswith("Cached") and component_total and value / component_total >= 0.70 else {}
                lines.append(fmt_detail([name, weekly, f"{value:.1f}", pct], cw, cr, st))

            # MAIN / SUB SUMMARY
            main_map, sub_map = main_sub_maps(b)
            lines.append("")
            lines.append(color.wrap("Main vs subagents", color.BOLD, color.BLUE))
            rh = ["ROLE", "TIER(S)", "WEEKLY≈", "CREDITS*", "INPUT", "CACHED", "OUTPUT", "CACHE TAX", "SESSION%"]
            rw = fit_widths_to_target([10, 10, 12, 11, 9, 9, 9, 10, 9], detail_width, (0,))
            rr = {2, 3, 4, 5, 6, 7, 8}
            lines.append(fmt_detail(rh, rw, rr, {i: "header" for i in range(len(rh))}))
            lines.append(color.wrap("  ".join("-" * w for w in rw), color.DIM))
            for role, mmap in (("MAIN", main_map), ("SUB", sub_map)):
                ru = Usage()
                for u in mmap.values():
                    ru = ru + u
                rcost, rcomplete = model_map_credits(mmap, fast)
                _, rcache, _, _ = cost_components_for_map(mmap, fast)
                pct = (
                    f"{100.0 * rcost / total_credits:.1f}%"
                    if rcost is not None and total_credits not in (None, 0)
                    else "—"
                )
                lines.append(fmt_detail([
                    role, tier_label(mmap.keys()), weekly_percent_text(rcost, quota_calibration, rcomplete),
                    "—" if rcost is None else f"{rcost:.1f}" + ("" if rcomplete else "+"),
                    human_tokens(ru.input_tokens), human_tokens(ru.cached_input_tokens),
                    human_tokens(ru.output_tokens), f"{rcache:.1f}" if rcache else "—", pct,
                ], rw, rr, {0: "active" if role == "MAIN" and state == "ACTIVE" else None}))

            # MODEL BREAKDOWN
            lines.append("")
            lines.append(color.wrap("Model breakdown", color.BOLD, color.BLUE))
            mh = ["MODEL", "TIER", "WEEKLY≈", "CREDITS*", "INPUT", "CACHED", "OUTPUT", "REASON", "CACHE TAX", "SESSION%"]
            mw = fit_widths_to_target([18, 9, 11, 10, 8, 8, 8, 8, 9, 9], detail_width, (0,))
            mr = {2, 3, 4, 5, 6, 7, 8, 9}
            lines.append(fmt_detail(mh, mw, mr, {i: "header" for i in range(len(mh))}))
            lines.append(color.wrap("  ".join("-" * w for w in mw), color.DIM))
            model_rows = []
            for model_key, u in b.usage_by_model.items():
                model, tier = split_usage_key(model_key)
                c, complete = _credit_for_usage_with_completeness(model_key, u, fast)
                comp, _ = _credit_components_for_usage_with_completeness(model_key, u, fast)
                cache_part = comp[1] if comp else 0.0
                model_rows.append((model, tier, u, c, complete, cache_part))
            model_rows.sort(key=lambda x: (x[3] if x[3] is not None else -1), reverse=True)
            for model, tier, u, c, complete, cache_part in model_rows:
                pct = f"{100.0 * c / total_credits:.1f}%" if c is not None and total_credits not in (None, 0) else "—"
                model_text, model_lines = model_cell_layout([model], mw[0], detail_width)
                lines.append(fmt_detail([
                    model_text, service_tier_display(tier, compact=True),
                    weekly_percent_text(c, quota_calibration, complete),
                    "—" if c is None else f"{c:.1f}" + ("" if complete else "+"), human_tokens(u.input_tokens),
                    human_tokens(u.cached_input_tokens), human_tokens(u.output_tokens),
                    human_tokens(u.reasoning_output_tokens), f"{cache_part:.1f}" if cache_part else "—", pct,
                ], mw, mr))
                lines.extend(color.wrap(line, color.DIM) for line in model_lines)

            # AGENT BREAKDOWN
            lines.append("")
            lines.append(color.wrap("Agent breakdown", color.BOLD, color.BLUE))
            agent_tokens_inline = detail_width >= REPORT_MAX_WIDTH
            if agent_tokens_inline:
                ah = ["PROJECT", "ROLE / SESSION", "MODEL(S)", "TIER(S)", "WEEKLY≈", "CREDITS*", "INPUT", "CACHED", "OUTPUT", "CACHE TAX", "SESSION%"]
                aw = [16, 28, 12, 9, 9, 9, 8, 8, 7, 9, 9]
            else:
                ah = ["PROJECT", "ROLE / SESSION", "MODEL(S)", "TIER(S)", "WEEKLY≈", "CREDITS*", "SESSION%"]
                aw = shrink_widths_to_target(
                    [18, 40, 16, 9, 11, 10, 9], [7, 12, 8, 5, 7, 8, 8],
                    detail_width, (0, 2, 3, 1, 4, 5, 6),
                )
                aw = fit_widths_to_target(aw, detail_width, (1,))
            ar = set(range(4, len(ah)))
            lines.append(fmt_detail(ah, aw, ar, {i: "header" for i in range(len(ah))}))
            lines.append(color.wrap("  ".join("-" * w for w in aw), color.DIM))
            agent_rows = []
            for sid, by_model in b.usage_by_source.items():
                u = b.source_usage(sid)
                c, complete = model_map_credits(by_model, fast)
                _, cache_part, _, _ = cost_components_for_map(by_model, fast)
                role = "SUB" if sid in b.source_is_subagent else "MAIN"
                source_session = sessions.get(sid)
                source_project = b.source_projects.get(sid) or (
                    project if sid == b.session_id else
                    _cwd_project_label(source_session.cwd) if source_session is not None else ""
                )
                title = session_without_project(b.source_titles.get(sid, short_sid(sid)), source_project)
                label = f"{role} {short_sid(sid)} {title}"
                agent_rows.append((sid, label, by_model, u, c, complete, cache_part, source_project))
            agent_rows.sort(
                key=lambda x: (0 if x[0] not in b.source_is_subagent else 1, -(x[4] if x[4] is not None else -1))
            )
            visible_agents = agent_rows if all_agents else agent_rows[:max(0, top_agents)]
            for sid, label, by_model, u, c, complete, cache_part, source_project in visible_agents:
                pct = f"{100.0 * c / total_credits:.1f}%" if c is not None and total_credits not in (None, 0) else "—"
                credit_text = "—" if c is None else f"{c:.1f}" + ("" if complete else "+")
                role_style = "active" if sid not in b.source_is_subagent and state == "ACTIVE" else None
                model_text, model_lines = model_cell_layout(by_model.keys(), aw[2], detail_width)
                agent_row = [
                    source_project or "—", label, model_text, tier_label(by_model.keys()),
                    weekly_percent_text(c, quota_calibration, complete), credit_text,
                ]
                if agent_tokens_inline:
                    agent_row += [human_tokens(u.input_tokens), human_tokens(u.cached_input_tokens),
                                  human_tokens(u.output_tokens), f"{cache_part:.1f}" if cache_part else "—"]
                agent_row.append(pct)
                lines.append(fmt_detail(agent_row, aw, ar, {1: role_style} if role_style else {}))
                lines.extend(color.wrap(line, color.DIM) for line in model_lines)
                if not agent_tokens_inline:
                    diagnostic = f"TOKENS I/C/O {token_triplet_text(u)} · CACHE TAX {cache_part:.1f}"
                    lines.extend(color.wrap("  " + part, color.DIM)
                                 for part in wrap_display_words(diagnostic, detail_width - 2))
            hidden = len(agent_rows) - len(visible_agents)
            if hidden > 0:
                lines.append(color.wrap(
                    f"… {hidden} more agents hidden; use --all-agents to show all.",
                    color.DIM,
                ))

    return "\n".join(lines)


def render_json(
    buckets: Dict[str, Bucket],
    sessions: Dict[str, RawSession],
    period_label: str,
    tz,
    fast: bool,
    now: datetime,
    live_report: bool,
    auth_context: Optional[LocalAuthContext] = None,
    quota_snapshot: Optional[QuotaSnapshot] = None,
    quota_calibration: Optional[QuotaCalibration] = None,
    quota_local_credits: Optional[float] = None,
) -> str:
    out = {
        "period": period_label,
        "timezone": _tz_label(tz),
        "credit_mode": "tier_aware_assume_unknown_fast" if fast else "tier_aware",
        "subscription": {
            "plan_type": (quota_snapshot.plan_type if quota_snapshot else "") or (auth_context.plan_type if auth_context else ""),
            "plan_display": plan_display_name((quota_snapshot.plan_type if quota_snapshot else "") or (auth_context.plan_type if auth_context else "")),
            "weekly_used_percent": quota_snapshot.used_percent if quota_snapshot else None,
            "weekly_left_percent": max(0.0, 100.0 - quota_snapshot.used_percent) if quota_snapshot else None,
            "weekly_resets_at": quota_snapshot.resets_at if quota_snapshot else None,
            "snapshot_at": quota_snapshot.ts.isoformat() if quota_snapshot else None,
            "local_week_credits": quota_local_credits,
            "local_weekly_estimate_percent": (quota_local_credits / quota_calibration.credits_per_percent) if (quota_local_credits is not None and quota_calibration and quota_calibration.credits_per_percent) else None,
            "weekly_estimate_basis": "one_plan_weekly_allowance",
            "credits_per_weekly_percent": quota_calibration.credits_per_percent if quota_calibration else None,
            "effective_weekly_credit_capacity": quota_calibration.effective_weekly_credits if quota_calibration else None,
            "calibration_confidence": quota_calibration.confidence if quota_calibration else None,
            "calibration_source": quota_calibration.source if quota_calibration else None,
            "calibration_clean_intervals": quota_calibration.clean_intervals if quota_calibration else 0,
            "calibration_observed_percent_points": quota_calibration.observed_percent_points if quota_calibration else 0.0,
            "local_coverage_percent": quota_calibration.local_coverage_percent if quota_calibration else None,
        },
        "sessions": [],
    }
    for b in buckets.values():
        u = b.total_usage()
        credits, complete = bucket_credits(b, sessions, fast)

        model_breakdown = []
        for model_key, mu in b.usage_by_model.items():
            model, tier = split_usage_key(model_key)
            mc, mcomplete = _credit_for_usage_with_completeness(model_key, mu, fast)
            mcomp, _ = _credit_components_for_usage_with_completeness(model_key, mu, fast)
            model_breakdown.append({
                "model": model,
                "service_tier": tier,
                "input_tokens": mu.input_tokens,
                "cached_input_tokens": mu.cached_input_tokens,
                "output_tokens": mu.output_tokens,
                "reasoning_output_tokens": mu.reasoning_output_tokens,
                "credit_estimate": mc,
                "credit_estimate_complete": mcomplete,
                "weekly_estimate_percent": (mc / quota_calibration.credits_per_percent) if (mc is not None and quota_calibration and quota_calibration.credits_per_percent) else None,
                "weekly_estimate_is_lower_bound": bool(mc is not None and not mcomplete),
                "cache_tax_credits": mcomp[1] if mcomp else None,
            })
        model_breakdown.sort(key=lambda x: x["credit_estimate"] if x["credit_estimate"] is not None else -1, reverse=True)

        tier_breakdown = []
        for tier, tier_map in group_by_service_tier(b.usage_by_model).items():
            tc, tcomplete = model_map_credits(tier_map, fast)
            tier_breakdown.append({
                "service_tier": tier,
                "credit_estimate": tc,
                "credit_estimate_complete": tcomplete,
                "weekly_estimate_percent": (tc / quota_calibration.credits_per_percent) if (tc is not None and quota_calibration and quota_calibration.credits_per_percent) else None,
                "weekly_estimate_is_lower_bound": bool(tc is not None and not tcomplete),
            })
        tier_breakdown.sort(key=lambda x: SERVICE_TIER_ORDER.index(x["service_tier"]) if x["service_tier"] in SERVICE_TIER_ORDER else 99)

        agent_breakdown = []
        for sid, by_model in b.usage_by_source.items():
            au = b.source_usage(sid)
            ac, acomplete = model_map_credits(by_model, fast)
            _, acache, _, _ = cost_components_for_map(by_model, fast)
            agent_breakdown.append({
                "session_id": sid,
                "role": "subagent" if sid in b.source_is_subagent else "main",
                "title": b.source_titles.get(sid, ""),
                "models": model_names(by_model.keys()),
                "service_tiers": service_tiers(by_model.keys()),
                "input_tokens": au.input_tokens,
                "cached_input_tokens": au.cached_input_tokens,
                "output_tokens": au.output_tokens,
                "reasoning_output_tokens": au.reasoning_output_tokens,
                "credit_estimate": ac,
                "cache_tax_credits": acache,
                "credit_estimate_complete": acomplete,
            })
        agent_breakdown.sort(key=lambda x: (0 if x["role"] == "main" else 1, -(x["credit_estimate"] if x["credit_estimate"] is not None else -1)))

        main_map, sub_map = main_sub_maps(b)
        _, cache_tax, _, _ = cost_components_for_map(b.usage_by_model, fast)
        main_credits, _ = model_map_credits(main_map, fast)
        sub_credits, _ = model_map_credits(sub_map, fast)
        state = thread_state(b, now, live_report)
        health = effective_health(b, fast, state)
        burn, recent_cache, burn_complete = recent_burn(b, fast)
        out["sessions"].append({
            "session_id": b.session_id,
            "title": b.title,
            "session_name": b.session_name or None,
            "thread_title": b.thread_title or None,
            "project_id": b.project_id or None,
            "project_name": b.project_name or None,
            "cwd": b.cwd,
            "thread_state": state,
            "thread_health": health,
            "last_activity": b.last_activity.isoformat() if b.last_activity else None,
            "trailing_1h_weekly_estimate_percent": (burn / quota_calibration.credits_per_percent) if (burn is not None and quota_calibration and quota_calibration.credits_per_percent) else None,
            "trailing_1h_credit_burn": burn,
            "trailing_1h_cache_tax": recent_cache,
            "cache_tax_credits": cache_tax,
            "main_credit_estimate": main_credits,
            "subagent_credit_estimate": sub_credits,
            "models": model_names(b.usage_by_model.keys()),
            "service_tiers": service_tiers(b.usage_by_model.keys()),
            "input_tokens": u.input_tokens,
            "cached_input_tokens": u.cached_input_tokens,
            "uncached_input_tokens": max(0, u.input_tokens - min(u.input_tokens, u.cached_input_tokens)),
            "output_tokens": u.output_tokens,
            "reasoning_output_tokens": u.reasoning_output_tokens,
            "credit_estimate": credits,
            "weekly_estimate_percent": (credits / quota_calibration.credits_per_percent) if (credits is not None and quota_calibration and quota_calibration.credits_per_percent) else None,
            "weekly_estimate_is_lower_bound": bool(credits is not None and not complete),
            "credit_estimate_complete": complete,
            "rolled_up_subagents": sorted(b.child_sessions),
            "tier_breakdown": tier_breakdown,
            "model_breakdown": model_breakdown,
            "agent_breakdown": agent_breakdown,
        })
    out["sessions"].sort(key=lambda x: (x["credit_estimate"] if x["credit_estimate"] is not None else -1, x["input_tokens"] + x["output_tokens"]), reverse=True)
    return json.dumps(out, ensure_ascii=False, indent=2)


def render_csv(
    buckets: Dict[str, Bucket],
    sessions: Dict[str, RawSession],
    fast: bool,
    now: datetime,
    live_report: bool,
    auth_context: Optional[LocalAuthContext] = None,
    quota_snapshot: Optional[QuotaSnapshot] = None,
    quota_calibration: Optional[QuotaCalibration] = None,
) -> str:
    sio = io.StringIO()
    writer = csv.writer(sio)
    writer.writerow([
        "session_id", "title", "session_name", "thread_title", "project_id",
        "project_name", "cwd", "models", "service_tiers", "credit_mode",
        "input_tokens", "cached_input_tokens", "uncached_input_tokens", "output_tokens",
        "reasoning_output_tokens", "credit_estimate", "weekly_estimate_percent",
        "weekly_estimate_is_lower_bound", "cache_tax_credits", "subscription_plan",
        "weekly_used_percent", "calibration_credits_per_percent", "calibration_confidence",
        "calibration_source", "main_credit_estimate", "subagent_credit_estimate",
        "thread_state", "thread_health", "last_activity", "trailing_1h_credit_burn",
        "trailing_1h_cache_tax", "rolled_up_subagents",
    ])
    for b in buckets.values():
        u = b.total_usage()
        credits, credit_complete = bucket_credits(b, sessions, fast)
        _, cache_tax, _, _ = cost_components_for_map(b.usage_by_model, fast)
        main_map, sub_map = main_sub_maps(b)
        main_c, _ = model_map_credits(main_map, fast)
        sub_c, _ = model_map_credits(sub_map, fast)
        state = thread_state(b, now, live_report)
        health = effective_health(b, fast, state)
        burn, recent_cache, _ = recent_burn(b, fast)
        writer.writerow([
            b.session_id,
            b.title,
            b.session_name,
            b.thread_title,
            b.project_id,
            b.project_name,
            b.cwd,
            ",".join(model_names(b.usage_by_model.keys())),
            ",".join(service_tiers(b.usage_by_model.keys())),
            "tier_aware_assume_unknown_fast" if fast else "tier_aware",
            u.input_tokens,
            u.cached_input_tokens,
            max(0, u.input_tokens - min(u.input_tokens, u.cached_input_tokens)),
            u.output_tokens,
            u.reasoning_output_tokens,
            "" if credits is None else f"{credits:.6f}",
            "" if (credits is None or not quota_calibration or not quota_calibration.credits_per_percent) else f"{credits / quota_calibration.credits_per_percent:.6f}",
            "1" if (credits is not None and not credit_complete) else "0",
            f"{cache_tax:.6f}",
            (quota_snapshot.plan_type if quota_snapshot else "") or (auth_context.plan_type if auth_context else ""),
            "" if quota_snapshot is None else f"{quota_snapshot.used_percent:.6f}",
            "" if not quota_calibration or not quota_calibration.credits_per_percent else f"{quota_calibration.credits_per_percent:.6f}",
            "" if quota_calibration is None else quota_calibration.confidence,
            "" if quota_calibration is None else quota_calibration.source,
            "" if main_c is None else f"{main_c:.6f}",
            "" if sub_c is None else f"{sub_c:.6f}",
            state,
            health,
            b.last_activity.isoformat() if b.last_activity else "",
            "" if burn is None else f"{burn:.6f}",
            f"{recent_cache:.6f}",
            len(b.child_sessions),
        ])
    return sio.getvalue()


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="codex-usage",
        description="Show per-session Codex token/credit usage from local session transcripts.",
    )
    p.add_argument(
        "period",
        nargs="?",
        default="today",
        help="6h | 12h | 24h | 48h | any Nh | today | yesterday | week | 7d | YYYY-MM-DD | YYYY-MM-DD..YYYY-MM-DD",
    )
    p.add_argument(
        "--codex-home",
        default=os.environ.get("CODEX_HOME", str(Path.home() / ".codex")),
        help="Codex home directory (default: $CODEX_HOME or ~/.codex)",
    )
    p.add_argument(
        "--timezone",
        help="IANA timezone, e.g. Asia/Tokyo. Default: system local timezone. On Windows, named IANA zones may require the optional tzdata package.",
    )
    p.add_argument(
        "--show-subagents",
        action="store_true",
        help="Show subagent threads separately instead of rolling them into the visible/root session.",
    )
    p.add_argument(
        "--no-archived",
        action="store_true",
        help="Do not scan archived_sessions.",
    )
    p.add_argument(
        "--fast",
        action="store_true",
        help="Resolve only service-tier segments that remain UNKNOWN as Fast; detected Standard/Fast segments are preserved.",
    )
    p.add_argument("--details", action="store_true", help="Show credit components, MAIN/SUB totals, models, agents and live trend diagnostics.")
    p.add_argument("--wide", action="store_true", help="Add INPUT/CACHED/OUTPUT token triplets on continuation lines, preserving PROJECT/SESSION width.")
    p.add_argument("--top-agents", type=int, default=8, metavar="N", help="With --details, show the top N agents per session (default: 8).")
    p.add_argument("--all-agents", action="store_true", help="With --details, show every agent instead of truncating the agent table.")
    p.add_argument("--color", choices=("auto", "always", "never"), default="auto", help="ANSI color mode for terminal output (default: auto; NO_COLOR is respected).")
    p.add_argument("--perf", action="store_true", help="Show index/read timing and bytes scanned.")
    p.add_argument("--no-cache", action="store_true", help="Bypass the persistent incremental index and parse JSONL directly.")
    p.add_argument("--rebuild-cache", action="store_true", help="Clear and rebuild the incremental index from all discovered rollouts.")
    p.add_argument("--cache-info", action="store_true", help="Show cache path/size/index counts and exit.")
    p.add_argument("--cache-path", help="Override the incremental SQLite cache path.")
    p.add_argument("--full-discovery", action="store_true", help="Force a full rollout tree walk instead of the warm-cache hot discovery path.")
    p.add_argument("--no-quota", action="store_true", help="Disable local ChatGPT plan/weekly quota discovery and WEEKLY≈ calibration.")
    group = p.add_mutually_exclusive_group()
    group.add_argument("--json", action="store_true", help="Emit JSON.")
    group.add_argument("--csv", action="store_true", help="Emit CSV.")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return p


def main(argv: Optional[List[str]] = None) -> int:
    _ensure_utf8_stdio()
    args = build_parser().parse_args(argv)
    codex_home = Path(args.codex_home).expanduser()
    tz = get_tz(args.timezone)
    start, end, period_label = parse_period(args.period, tz)

    cache_path = Path(args.cache_path).expanduser() if args.cache_path else default_cache_path()
    if args.cache_info:
        conn = _cache_connect(cache_path)
        try:
            print(cache_info(conn, cache_path))
        finally:
            conn.close()
        return 0

    auth_context = LocalAuthContext()
    quota_snapshot = None
    quota_week_start = None
    pre_now = _now_in_tz(tz)
    if not args.no_quota:
        auth_context = read_local_auth_context(codex_home)
        quota_snapshot = read_latest_quota_snapshot(codex_home, tz, auth_context.plan_type)
        if quota_snapshot is not None and not quota_snapshot.plan_type:
            quota_snapshot.plan_type = auth_context.plan_type
        if quota_snapshot is not None:
            quota_week_start = quota_window_start(quota_snapshot, tz)

    scan_start = start
    if quota_week_start is not None and quota_week_start < scan_start:
        scan_start = quota_week_start
    scan_end = max(end, pre_now)

    t_total = time.perf_counter()
    sessions: Dict[str, RawSession] = {}
    malformed = 0
    perf_stats = None

    if args.no_cache:
        paths, discovery_mode, discovery_s = discover_rollouts(
            codex_home, include_archived=not args.no_archived
        )
        if not paths:
            eprint(f"No session JSONL files found under {codex_home}")
            return 2
        # No-cache mode remains available for verification/debugging.
        try:
            paths.sort(key=lambda p: p.stat().st_mtime)
        except OSError:
            pass
        parse_start = time.perf_counter()
        bytes_read = 0
        for path in paths:
            try:
                bytes_read += path.stat().st_size
            except OSError:
                pass
            parsed = parse_rollout(path)
            if parsed is None:
                continue
            sessions[parsed.session_id] = parsed
            malformed += parsed.malformed_lines
        perf_stats = CacheStats(
            discovered_files=len(paths), bytes_read=bytes_read,
            cold_scans=len(paths), elapsed_s=time.perf_counter() - parse_start,
            discovery_s=discovery_s, discovery_mode=discovery_mode,
        )
    else:
        conn = _cache_connect(cache_path)
        try:
            paths, discovery_mode, discovery_s = discover_rollouts(
                codex_home,
                include_archived=not args.no_archived,
                start=scan_start,
                end=scan_end,
                cache_conn=conn,
                force_full=(args.rebuild_cache or args.full_discovery),
            )
            if not paths:
                eprint(f"No session JSONL files found under {codex_home}")
                return 2
            perf_stats = sync_incremental_cache(
                conn, paths, scan_start, scan_end, rebuild=args.rebuild_cache
            )
            perf_stats.discovery_s = discovery_s
            perf_stats.discovery_mode = discovery_mode
            sessions = _load_sessions_from_cache(conn, {str(p) for p in paths})
        finally:
            conn.close()
        malformed = sum(s.malformed_lines for s in sessions.values())

    # An empty session set is valid for narrow windows on a fresh cache: all
    # discovered files may simply predate the requested interval. Render the
    # normal "No token_count usage" result rather than treating it as an error.
    now = _now_in_tz(tz)
    effective_end = min(end, now)
    trend_start = effective_end - timedelta(minutes=TREND_MINUTES)
    live_report = report_is_live(start, end, now)

    index = load_thread_index(codex_home)
    buckets = make_buckets(
        sessions=sessions,
        index=index,
        start=start,
        end=end,
        tz=tz,
        show_subagents=args.show_subagents,
        trend_start=trend_start,
    )

    quota_calibration = None
    quota_local_credits = None
    quota_complete = True
    if quota_snapshot is not None and quota_week_start is not None:
        quota_end = _to_tz(quota_snapshot.ts, tz) + timedelta(microseconds=1)
        if quota_end > quota_week_start:
            weekly_buckets = make_buckets(
                sessions=sessions,
                index=index,
                start=quota_week_start,
                end=quota_end,
                tz=tz,
                show_subagents=False,
                trend_start=None,
            )
            quota_local_credits, quota_complete = bucket_collection_credits(weekly_buckets, sessions, args.fast)
            quota_conn = _cache_connect(cache_path)
            try:
                interval_anchor = _quota_interval_anchor(
                    quota_conn, auth_context, quota_snapshot, args.fast
                )
                if interval_anchor is not None:
                    interval_start = _to_tz(interval_anchor.ts, tz)
                    interval_end = _to_tz(quota_snapshot.ts, tz) + timedelta(microseconds=1)
                    interval_buckets = make_buckets(
                        sessions=sessions, index=index, start=interval_start, end=interval_end,
                        tz=tz, show_subagents=False, trend_start=None,
                    )
                    interval_credits, interval_complete = bucket_collection_credits(
                        interval_buckets, sessions, args.fast
                    )
                    _record_quota_interval(
                        quota_conn, auth_context, interval_anchor, quota_snapshot,
                        interval_credits, interval_complete, args.fast,
                    )
                _record_quota_snapshot(quota_conn, auth_context, quota_snapshot, args.fast)

                current_complete_credits = None
                if quota_local_credits is not None and quota_complete and quota_snapshot.used_percent >= 1.0:
                    _record_quota_observation(
                        quota_conn, auth_context, quota_snapshot, quota_local_credits, args.fast
                    )
                    current_complete_credits = quota_local_credits
                quota_calibration = load_quota_calibration(
                    quota_conn, auth_context, quota_snapshot, current_complete_credits, args.fast
                )
                if not quota_calibration.credits_per_percent:
                    rebased = _try_rebase_legacy_observation(
                        quota_conn, auth_context, quota_snapshot, sessions, index, tz, args.fast
                    )
                    if rebased is not None:
                        quota_calibration = load_quota_calibration(
                            quota_conn, auth_context, quota_snapshot, current_complete_credits, args.fast
                        )
                if not quota_calibration.credits_per_percent:
                    quota_calibration = bootstrap_quota_calibration(auth_context, quota_snapshot)
            finally:
                quota_conn.close()

    color_mode = "never" if (args.json or args.csv) else args.color
    color = Colorizer(color_mode)
    if args.json:
        print(render_json(
            buckets, sessions, period_label, tz, args.fast, now, live_report,
            auth_context, quota_snapshot, quota_calibration, quota_local_credits,
        ))
    elif args.csv:
        print(render_csv(
            buckets, sessions, args.fast, now, live_report,
            auth_context, quota_snapshot, quota_calibration,
        ), end="")
    else:
        print(render_table(
            buckets, sessions, period_label, tz, args.fast, args.details,
            now, live_report, color, wide=args.wide,
            top_agents=max(0, args.top_agents), all_agents=args.all_agents,
            auth_context=auth_context, quota_snapshot=quota_snapshot,
            quota_calibration=quota_calibration, quota_local_credits=quota_local_credits,
            quota_local_complete=quota_complete,
        ))

    if malformed and not (args.json or args.csv):
        eprint(f"Warning: skipped {malformed} malformed/oversized JSONL line(s).")

    if args.perf:
        total_s = time.perf_counter() - t_total
        if args.no_cache:
            eprint(
                f"Perf: no-cache | discovery={perf_stats.discovery_mode} "
                f"{perf_stats.discovery_s:.3f}s | files={perf_stats.discovered_files} | "
                f"read≈{perf_stats.bytes_read / (1024*1024):.1f} MiB | "
                f"parse={perf_stats.elapsed_s:.3f}s | total={total_s:.3f}s"
            )
        else:
            eprint(
                f"Perf: incremental-index | discovery={perf_stats.discovery_mode} "
                f"{perf_stats.discovery_s:.3f}s | files={perf_stats.discovered_files} | "
                f"hits={perf_stats.cache_hits} | cold={perf_stats.cold_scans} | "
                f"ancestor={perf_stats.ancestor_scans} | tail={perf_stats.incremental_scans} | "
                f"skipped-old={perf_stats.skipped_old_uncached} | "
                f"read={perf_stats.bytes_read / (1024*1024):.1f} MiB | "
                f"sync={perf_stats.elapsed_s:.3f}s | total={total_s:.3f}s"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
