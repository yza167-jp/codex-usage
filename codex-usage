@dataclass
class RawSession:
    session_id: str
    path: Path
    created_at: Optional[datetime] = None
    cwd: str = ""
    source: object = ""
    thread_source: object = ""
    originator: str = ""
    parent_id: str = ""
    forked_from_id: str = ""
    model_provider: str = ""
    usage_events: List[UsageEvent] = field(default_factory=list)
    malformed_lines: int = 0

    def is_subagent(self) -> bool:
        if str(self.thread_source).lower() == "subagent":
            return True
        if isinstance(self.source, dict) and "subagent" in self.source:
            return True
        s = str(self.source).lower()
        return "subagent" in s

    def lineage_parent(self) -> str:
        return self.parent_id or self.forked_from_id


@dataclass
class Bucket:
    session_id: str
    title: str = ""
    cwd: str = ""
    source: str = ""
    usage_by_model: Dict[str, Usage] = field(default_factory=dict)
    # source session -> model -> usage. This preserves the main/subagent split
    # even when the default top-level view rolls child agents into their root.
    usage_by_source: Dict[str, Dict[str, Usage]] = field(default_factory=dict)
    source_titles: Dict[str, str] = field(default_factory=dict)
    source_is_subagent: set = field(default_factory=set)
    # Trailing TREND_MINUTES usage is kept separately for live burn-rate hints.
    recent_usage_by_model: Dict[str, Usage] = field(default_factory=dict)
    first_activity: Optional[datetime] = None
    last_activity: Optional[datetime] = None
    event_count: int = 0
    child_sessions: set = field(default_factory=set)

    def add(
        self,
        model: str,
        usage: Usage,
        source_session_id: str,
        source_title: str = "",
        is_subagent: bool = False,
        activity_ts: Optional[datetime] = None,
        recent: bool = False,
    ) -> None:
        model = model or "unknown"
        self.usage_by_model[model] = self.usage_by_model.get(model, Usage()) + usage

        by_model = self.usage_by_source.setdefault(source_session_id, {})
        by_model[model] = by_model.get(model, Usage()) + usage
        if source_title:
            self.source_titles[source_session_id] = source_title
        if is_subagent:
            self.source_is_subagent.add(source_session_id)

        if activity_ts is not None:
            if self.first_activity is None or activity_ts < self.first_activity:
                self.first_activity = activity_ts
            if self.last_activity is None or activity_ts > self.last_activity:
                self.last_activity = activity_ts
        if recent:
            self.recent_usage_by_model[model] = (
                self.recent_usage_by_model.get(model, Usage()) + usage
            )

        self.event_count += 1
        if source_session_id != self.session_id:
            self.child_sessions.add(source_session_id)

    def total_usage(self) -> Usage:
        out = Usage()
        for u in self.usage_by_model.values():
            out = out + u
        return out

    def source_usage(self, source_session_id: str) -> Usage:
        out = Usage()
        for u in self.usage_by_source.get(source_session_id, {}).values():
            out = out + u
        return out


def _path_key(path: Path) -> str:
    """Case-normalized absolute key for cross-platform path de-duplication."""
    return os.path.normcase(os.path.abspath(os.fspath(path)))


def _sqlite_i64(value: int) -> int:
    """Map an OS integer identifier into SQLite's signed 64-bit INTEGER range.

    Windows file IDs can use the full unsigned 64-bit range. SQLite INTEGER is
    signed 64-bit, so preserve the low 64 bits via two's-complement mapping.
    The mapping is one-to-one for 64-bit identifiers and stable for comparisons.
    """
    v = int(value) & ((1 << 64) - 1)
    return v if v < (1 << 63) else v - (1 << 64)


def _sqlite_ro_uri(path: Path) -> str:
    """
    Portable SQLite read-only URI.

    Path.as_uri() correctly encodes Windows drive letters, spaces and UNC-ish
    path characters, unlike string interpolation such as ``file:C:\\...``.
    """
    return path.resolve().as_uri() + "?mode=ro"


def _ensure_utf8_stdio() -> None:
    """Use UTF-8 when the inherited stdio encoding cannot represent rich output.

    Windows console streams are usually Unicode-capable, but redirected Python
    stdout/stderr can still inherit a legacy code page such as cp1252. Session
    titles and the terminal UI may contain arrows, CJK text, or other Unicode,
    so switch non-UTF-8 text wrappers to UTF-8 when Python allows it.
    """
    for name in ("stdout", "stderr"):
        stream = getattr(sys, name, None)
        if stream is None or not hasattr(stream, "reconfigure"):
            continue
        encoding = (getattr(stream, "encoding", None) or "").lower().replace("_", "-")
        if encoding in ("utf-8", "utf8"):
            continue
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, OSError, ValueError):
            pass


def _enable_windows_vt(stream) -> bool:
    """Enable ANSI/VT processing on a real Windows console when possible."""
    if os.name != "nt":
        return True
    try:
        if not stream.isatty():
            return False
        import ctypes
        import msvcrt

        handle = msvcrt.get_osfhandle(stream.fileno())
        mode = ctypes.c_uint()
        kernel32 = ctypes.windll.kernel32
        if not kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
            return False
        ENABLE_VIRTUAL_TERMINAL_PROCESSING = 0x0004
        if mode.value & ENABLE_VIRTUAL_TERMINAL_PROCESSING:
            return True
        return bool(
            kernel32.SetConsoleMode(
                handle, mode.value | ENABLE_VIRTUAL_TERMINAL_PROCESSING
            )
        )
    except (AttributeError, OSError, ValueError):
        return False


class Colorizer:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"

    def __init__(self, mode: str = "auto"):
        if mode == "always":
            if os.name == "nt" and sys.stdout.isatty():
                _enable_windows_vt(sys.stdout)
            self.enabled = True
        elif mode == "never":
            self.enabled = False
        else:
            enabled = (
                sys.stdout.isatty()
                and os.environ.get("TERM", "") != "dumb"
                and "NO_COLOR" not in os.environ
            )
            if enabled and os.name == "nt":
                enabled = _enable_windows_vt(sys.stdout)
            self.enabled = enabled

    def wrap(self, text: str, *styles: str) -> str:
        if not self.enabled or not styles:
            return text
        return "".join(styles) + text + self.RESET


