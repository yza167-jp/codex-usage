def short_sid(sid: str) -> str:
    # 8 hex chars collide frequently for UUIDv7 threads created close together.
    return sid[:13] if len(sid) >= 13 else sid


def human_age(ts: Optional[datetime], now: datetime) -> str:
    if ts is None:
        return "—"
    seconds = max(0, int((now - ts).total_seconds()))
    if seconds < 60:
        return "now" if seconds < 10 else f"{seconds}s"
    minutes = seconds // 60
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    if hours < 24:
        rem = minutes % 60
        return f"{hours}h{rem:02d}m" if rem else f"{hours}h"
    days = hours // 24
    return f"{days}d"


def parse_ts(value: object) -> Optional[datetime]:
    if not isinstance(value, str) or not value:
        return None
    s = value.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def id_from_filename(path: Path) -> str:
    matches = UUID_RE.findall(path.name)
    return matches[-1] if matches else path.stem


def normalize_model(model: object) -> str:
    if not model:
        return "unknown"
    s = str(model).strip().lower()
    # Bedrock IDs can still be recognized for token comparison, but ChatGPT
    # credits do not apply to API-key/Bedrock usage. We leave the provider
    # check to credit calculation.
    if s.startswith("openai."):
        s = s[len("openai."):]
    # Exact shorthand aliases are a tool compatibility convention. Match dated
    # Astra IDs narrowly; never price every gpt-6-* variant as the base model.
    if s in ("gpt-6", "gpt6"):
        return "gpt-6-astra"
    if re.fullmatch(r"gpt-6-astra-\d{4}-\d{2}-\d{2}", s):
        return "gpt-6-astra"
    return s


def normalize_service_tier(value: object) -> str:
    """Normalize persisted Codex service-tier spellings.

    Codex/API history may use ``priority`` for Fast. A present null/default
    value is Standard; absence of the field is handled by the caller and leaves
    the current tier unchanged/Unknown.
    """
    if value is None:
        return SERVICE_TIER_STANDARD
    tier = str(value).strip().lower().replace("-", "_")
    if tier in ("", "default", "standard", "auto", "none", "null"):
        return SERVICE_TIER_STANDARD
    if tier in ("fast", "priority"):
        return SERVICE_TIER_FAST
    if tier == "flex":
        return SERVICE_TIER_FLEX
    return SERVICE_TIER_UNKNOWN


def usage_key(model: object, service_tier: object) -> str:
    return f"{normalize_model(model)}{USAGE_KEY_SEP}{normalize_service_tier(service_tier)}"


def split_usage_key(key: object) -> Tuple[str, str]:
    raw = str(key or "unknown")
    if USAGE_KEY_SEP not in raw:
        # Pre-v1.6 programmatic maps are interpreted as Standard. Rollout data
        # always enters through usage_key() and can therefore preserve Unknown.
        return normalize_model(raw), SERVICE_TIER_STANDARD
    model, tier = raw.rsplit(USAGE_KEY_SEP, 1)
    return normalize_model(model), normalize_service_tier(tier)


def _mapping_service_tier(mapping: object) -> Optional[str]:
    if not isinstance(mapping, dict):
        return None
    for key in ("service_tier", "serviceTier"):
        if key in mapping:
            return normalize_service_tier(mapping.get(key))
    for key in ("thread_settings", "threadSettings", "settings", "snapshot", "turn_context"):
        nested = mapping.get(key)
        tier = _mapping_service_tier(nested)
        if tier is not None:
            return tier
    return None


def _mapping_model(mapping: object) -> Optional[str]:
    if not isinstance(mapping, dict):
        return None
    if mapping.get("model"):
        return normalize_model(mapping.get("model"))
    for key in ("thread_settings", "threadSettings", "settings", "snapshot", "turn_context"):
        nested = mapping.get(key)
        model = _mapping_model(nested)
        if model:
            return model
    return None


def _full_discover_rollouts(codex_home: Path, include_archived: bool) -> List[Path]:
    roots = [codex_home / "sessions"]
    if include_archived:
        roots.append(codex_home / "archived_sessions")

    # Do not resolve() every path: on APFS that creates needless metadata I/O.
    seen = set()
    out: List[Path] = []
    for root in roots:
        if not root.exists():
            continue
        for path in root.rglob("*.jsonl"):
            key = _path_key(path)
            if key in seen:
                continue
            seen.add(key)
            out.append(path)
    return out


def _epoch_seconds(value: object) -> Optional[float]:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        x = float(value)
        # Be tolerant of ms/us/ns epoch encodings.
        while x > 100_000_000_000:
            x /= 1000.0
        return x
    dt = parse_ts(value)
    return dt.timestamp() if dt is not None else None


def _recent_state_rollouts(codex_home: Path, since_epoch: float) -> List[Path]:
    """Best-effort recent rollout paths from Codex's local thread index."""
    db = codex_home / "state_5.sqlite"
    if not db.exists():
        return []
    out: List[Path] = []
    try:
        conn = sqlite3.connect(_sqlite_ro_uri(db), uri=True, timeout=0.5)
        conn.row_factory = sqlite3.Row
    except (sqlite3.Error, OSError):
        return out
    try:
        cols = {str(r[1]) for r in conn.execute("PRAGMA table_info(threads)")}
        if "rollout_path" not in cols:
            return out
        wanted = ["rollout_path"]
        if "updated_at" in cols:
            wanted.append("updated_at")
        q = "SELECT " + ",".join(f'"{c}"' for c in wanted) + ' FROM "threads"'
        for row in conn.execute(q):
            raw = row["rollout_path"]
            if not raw:
                continue
            if "updated_at" in wanted:
                updated = _epoch_seconds(row["updated_at"])
                if updated is not None and updated < since_epoch:
                    continue
            p = Path(str(raw)).expanduser()
            if not p.is_absolute():
                p = codex_home / p
            out.append(p)
    except sqlite3.Error:
        pass
    finally:
        conn.close()
    return out


def _recent_date_rollouts(
    codex_home: Path,
    start: datetime,
    end: datetime,
) -> List[Path]:
    """Scan only date buckets intersecting the report window."""
    root = codex_home / "sessions"
    if not root.exists():
        return []
    # Include one prior date for sessions created just before a rolling window.
    d = (start - timedelta(days=1)).date()
    last = min(end, datetime.now(end.tzinfo) + timedelta(days=1)).date()
    out: List[Path] = []
    max_days = 45
    days = 0
    while d <= last and days <= max_days:
        folder = root / f"{d.year:04d}" / f"{d.month:02d}" / f"{d.day:02d}"
        if folder.exists():
            out.extend(folder.rglob("*.jsonl"))
        d += timedelta(days=1)
        days += 1
    return out


def discover_rollouts(
    codex_home: Path,
    include_archived: bool,
    start: Optional[datetime] = None,
    end: Optional[datetime] = None,
    cache_conn: Optional[sqlite3.Connection] = None,
    force_full: bool = False,
) -> Tuple[List[Path], str, float]:
    """
    Full discovery is the reliability baseline. On a warm cache, a hot path
    avoids walking the entire historical tree on every invocation by combining:
      1) all already-indexed rollout paths,
      2) date buckets overlapping the requested window,
      3) recently updated rollout paths from state_5.sqlite.
    A full tree walk still runs periodically as a safety net.
    """
    t0 = time.perf_counter()
    if cache_conn is None or start is None or end is None:
        paths = _full_discover_rollouts(codex_home, include_archived)
        return paths, "full", time.perf_counter() - t0

    row = cache_conn.execute(
        "SELECT value FROM meta WHERE key='last_full_discovery_epoch'"
    ).fetchone()
    last_full = float(row[0]) if row is not None else 0.0
    indexed_n = int(cache_conn.execute("SELECT COUNT(*) FROM files").fetchone()[0])
    now_epoch = time.time()

    must_full = (
        force_full
        or indexed_n == 0
        or (now_epoch - last_full) >= FULL_DISCOVERY_INTERVAL_S
        or (end - start) > timedelta(days=45)
    )
    if must_full:
        paths = _full_discover_rollouts(codex_home, include_archived)
        cache_conn.execute(
            "INSERT OR REPLACE INTO meta(key,value) VALUES('last_full_discovery_epoch',?)",
            (str(now_epoch),),
        )
        cache_conn.commit()
        return paths, "full", time.perf_counter() - t0

    seen: Dict[str, Path] = {}

    # Indexed files are few after the cold-window optimization and include
    # long-lived sessions that were created outside the current date buckets.
    for row in cache_conn.execute("SELECT path FROM files"):
        p = Path(str(row[0]))
        seen[_path_key(p)] = p

    for p in _recent_date_rollouts(codex_home, start, end):
        seen[_path_key(p)] = p

    # state_5 catches an old thread that becomes active again after its original
    # date directory has fallen outside the current rolling window.
    state_since = start.timestamp() - 3600.0
    for p in _recent_state_rollouts(codex_home, state_since):
        seen[_path_key(p)] = p

    paths = list(seen.values())
    return paths, "hot", time.perf_counter() - t0


def _line_is_relevant(raw: bytes) -> bool:
    # Record type/settings live near the beginning of Codex JSONL lines.
    head = raw[:4096]
    if b"session_meta" in head or b"turn_context" in head:
        return True
    if b"thread_settings_applied" in head or b'"service_tier"' in head or b'"serviceTier"' in head:
        return True
    return b"event_msg" in head and b"token_count" in head


def _apply_record(
    session: RawSession,
    rec: dict,
    current_model: str,
    current_service_tier: str,
    own_meta_seen: bool,
):
    """Apply one relevant JSONL record.

    Returns ``(model, service_tier, own_meta_seen, usage_event)``. Tier settings
    are stateful because token_count records are cumulative snapshots emitted
    after the request whose model/tier was applied.
    """
    rtype = rec.get("type")
    payload = rec.get("payload") or {}
    ts = parse_ts(rec.get("timestamp"))
    event = None

    if rtype == "session_meta" and isinstance(payload, dict):
        if not own_meta_seen:
            own_meta_seen = True
            sid = payload.get("id") or payload.get("session_id")
            if sid:
                session.session_id = str(sid)
            session.cwd = str(payload.get("cwd") or "")
            session.source = payload.get("source") or ""
            session.thread_source = payload.get("thread_source") or ""
            session.originator = str(payload.get("originator") or "")
            session.parent_id = str(payload.get("parent_thread_id") or "")
            session.forked_from_id = str(payload.get("forked_from_id") or "")
            session.model_provider = str(payload.get("model_provider") or "")
            session.created_at = (
                parse_ts(payload.get("created_at"))
                or parse_ts(payload.get("timestamp"))
                or ts
            )
        model = _mapping_model(payload)
        tier = _mapping_service_tier(payload)
        if model:
            current_model = model
        if tier is not None:
            current_service_tier = tier
        return current_model, current_service_tier, own_meta_seen, None

    if rtype == "turn_context" and isinstance(payload, dict):
        current_model = normalize_model(payload.get("model") or current_model)
        tier = _mapping_service_tier(payload)
        if tier is not None:
            current_service_tier = tier
        return current_model, current_service_tier, own_meta_seen, None

    if rtype == "event_msg" and isinstance(payload, dict):
        event_type = str(payload.get("type") or "")
        if event_type == "thread_settings_applied":
            # ThreadSettingsApplied carries a full ThreadSettingsSnapshot. Its
            # optional service_tier field is omitted for the Standard/default
            # tier, so absence here must actively clear an earlier Fast state.
            model = _mapping_model(payload)
            tier = _mapping_service_tier(payload)
            if model:
                current_model = model
            current_service_tier = tier if tier is not None else SERVICE_TIER_STANDARD
        elif event_type in ("thread_settings", "turn_context"):
            model = _mapping_model(payload)
            tier = _mapping_service_tier(payload)
            if model:
                current_model = model
            if tier is not None:
                current_service_tier = tier
        else:
            # Some Codex versions place the applied service tier directly on a
            # token/event payload rather than in a dedicated settings snapshot.
            tier = _mapping_service_tier(payload)
            if tier is not None:
                current_service_tier = tier

        if event_type == "token_count":
            info = payload.get("info") or {}
            total = info.get("total_token_usage") if isinstance(info, dict) else None
            if isinstance(total, dict) and ts is not None:
                event = UsageEvent(
                    ts=ts,
                    cumulative=Usage.from_dict(total),
                    model=current_model,
                    service_tier=current_service_tier,
                )
    return current_model, current_service_tier, own_meta_seen, event


def parse_rollout(path: Path) -> Optional[RawSession]:
    """Full parse used by --no-cache; binary/pre-filtered to minimize allocations."""
    session = RawSession(session_id=id_from_filename(path), path=path)
    own_meta_seen = False
    current_model = "unknown"
    current_service_tier = SERVICE_TIER_UNKNOWN

    try:
        fh = path.open("rb", buffering=4 * 1024 * 1024)
    except OSError:
        return None

    with fh:
        for raw in fh:
            if not raw.startswith(b"{") or not _line_is_relevant(raw):
                continue
            try:
                rec = json.loads(raw)
            except (json.JSONDecodeError, UnicodeDecodeError, MemoryError):
                session.malformed_lines += 1
                continue
            current_model, current_service_tier, own_meta_seen, event = _apply_record(
                session, rec, current_model, current_service_tier, own_meta_seen
            )
            if event is not None:
                session.usage_events.append(event)

    if not own_meta_seen and not session.usage_events:
        return None
    if session.created_at is None and session.usage_events:
        session.created_at = session.usage_events[0].ts
    return session


def _decode_jwt_payload_unverified(jwt: str) -> Optional[dict]:
    """Decode a local JWT payload without signature verification.

    v1.5 intentionally treats auth.json as a local metadata source only. The
    token itself is never printed or persisted by codex-usage.
    """
    try:
        parts = jwt.split(".")
        if len(parts) < 2 or not parts[1]:
            return None
        payload = parts[1]
        payload += "=" * (-len(payload) % 4)
        raw = base64.urlsafe_b64decode(payload.encode("ascii"))
        obj = json.loads(raw.decode("utf-8"))
        return obj if isinstance(obj, dict) else None
    except (ValueError, UnicodeDecodeError, json.JSONDecodeError):
        return None


def read_local_auth_context(codex_home: Path) -> LocalAuthContext:
    auth_path = codex_home / "auth.json"
    try:
        data = json.loads(auth_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return LocalAuthContext()
    if not isinstance(data, dict):
        return LocalAuthContext()

    plan = ""
    identity = ""
    tokens = data.get("tokens")
    if isinstance(tokens, dict):
        id_token = tokens.get("id_token")
        if isinstance(id_token, str):
            claims = _decode_jwt_payload_unverified(id_token) or {}
            auth_claims = claims.get("https://api.openai.com/auth")
            if isinstance(auth_claims, dict):
                raw_plan = auth_claims.get("chatgpt_plan_type")
                if raw_plan:
                    plan = str(raw_plan).strip().lower()
                identity = str(
                    auth_claims.get("chatgpt_user_id")
                    or auth_claims.get("user_id")
                    or auth_claims.get("chatgpt_account_id")
                    or ""
                )
        if not identity:
            identity = str(tokens.get("account_id") or "")

    agent_identity = data.get("agent_identity")
    if isinstance(agent_identity, dict):
        if not plan and agent_identity.get("plan_type"):
            plan = str(agent_identity.get("plan_type")).strip().lower()
        if not identity:
            identity = str(
                agent_identity.get("chatgpt_user_id")
                or agent_identity.get("account_id")
                or ""
            )

    account_key = "local"
    if identity:
        account_key = hashlib.sha256(identity.encode("utf-8")).hexdigest()[:16]
    return LocalAuthContext(plan_type=plan, account_key=account_key, source="auth.json")


def plan_display_name(raw: str) -> str:
    key = (raw or "").strip().lower()
    if not key:
        return "Unknown plan"
    return PLAN_DISPLAY_NAMES.get(key, key.replace("_", " ").title())


def _weekly_window(rate_limits: dict) -> Optional[dict]:
    candidates = []
    for name in ("primary", "secondary"):
        window = rate_limits.get(name)
        if not isinstance(window, dict):
            continue
        try:
            used = float(window.get("used_percent"))
            minutes = int(window.get("window_minutes"))
        except (TypeError, ValueError):
            continue
        if not (0.0 <= used <= 100.0):
            continue
        # Prefer exactly seven days, but tolerate small backend variations.
        distance = abs(minutes - WEEKLY_WINDOW_MINUTES)
        if distance <= 24 * 60:
            candidates.append((distance, name, used, minutes, window.get("resets_at")))
    if not candidates:
        return None
    _, name, used, minutes, resets = min(candidates, key=lambda item: item[0])
    try:
        resets_at = int(resets) if resets is not None else None
    except (TypeError, ValueError):
        resets_at = None
    return {
        "name": name,
        "used_percent": used,
        "window_minutes": minutes,
        "resets_at": resets_at,
    }


def _quota_snapshot_from_record(rec: dict, fallback_plan: str = "") -> Optional[QuotaSnapshot]:
    if rec.get("type") != "event_msg":
        return None
    payload = rec.get("payload")
    if not isinstance(payload, dict) or payload.get("type") != "token_count":
        return None
    rate_limits = payload.get("rate_limits")
    if not isinstance(rate_limits, dict):
        return None
    weekly = _weekly_window(rate_limits)
    if weekly is None:
        return None
    ts = parse_ts(rec.get("timestamp"))
    if ts is None:
        return None
    limit_id = str(rate_limits.get("limit_id") or "codex").strip().lower().replace("-", "_")
    plan = str(rate_limits.get("plan_type") or fallback_plan or "").strip().lower()
    credits = rate_limits.get("credits")
    balance = None
    if isinstance(credits, dict) and credits.get("balance") is not None:
        balance = str(credits.get("balance"))
    return QuotaSnapshot(
        ts=ts,
        used_percent=float(weekly["used_percent"]),
        window_minutes=int(weekly["window_minutes"]),
        resets_at=weekly["resets_at"],
        plan_type=plan,
        limit_id=limit_id,
        source="rollout",
        credit_balance=balance,
    )


def _latest_quota_in_rollout(path: Path, fallback_plan: str) -> Optional[QuotaSnapshot]:
    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            start = max(0, size - QUOTA_TAIL_BYTES)
            fh.seek(start)
            data = fh.read()
    except OSError:
        return None
    if start > 0:
        split = data.split(b"\n", 1)
        data = split[1] if len(split) == 2 else b""

    fallback = None
    for raw in reversed(data.splitlines()):
        if b"token_count" not in raw or b"rate_limits" not in raw:
            continue
        try:
            rec = json.loads(raw)
        except (json.JSONDecodeError, UnicodeDecodeError, MemoryError):
            continue
        snap = _quota_snapshot_from_record(rec, fallback_plan)
        if snap is None:
            continue
        if snap.limit_id in ("", "codex"):
            return snap
        if fallback is None:
            fallback = snap
    return fallback


def read_latest_quota_snapshot(codex_home: Path, tz, fallback_plan: str = "") -> Optional[QuotaSnapshot]:
    now = _now_in_tz(tz)
    seen: Dict[str, Path] = {}
    for path in _recent_date_rollouts(codex_home, now - timedelta(days=3), now + timedelta(days=1)):
        seen[_path_key(path)] = path
    for path in _recent_state_rollouts(codex_home, now.timestamp() - 7 * 24 * 3600):
        seen[_path_key(path)] = path

    ranked = []
    for path in seen.values():
        try:
            ranked.append((path.stat().st_mtime_ns, path))
        except OSError:
            pass
    ranked.sort(reverse=True, key=lambda item: item[0])

    best = None
    # Compare several recently modified rollouts instead of trusting the first
    # file's latest quota event. An active rollout can receive non-token lines
    # after its last rate-limit snapshot while another thread has a newer one.
    for _, path in ranked[:8]:
        snap = _latest_quota_in_rollout(path, fallback_plan)
        if snap is None:
            continue
        if best is None or snap.ts > best.ts:
            best = snap
    return best


def quota_window_start(snapshot: QuotaSnapshot, tz) -> Optional[datetime]:
    if snapshot.resets_at is None or snapshot.window_minutes <= 0:
        return None
    reset_utc = datetime.fromtimestamp(snapshot.resets_at, tz=timezone.utc)
    start_utc = reset_utc - timedelta(minutes=snapshot.window_minutes)
    return _to_tz(start_utc, tz)


def human_until(epoch: Optional[int], now: datetime) -> str:
    if epoch is None:
        return "unknown"
    seconds = int(epoch - now.timestamp())
    if seconds <= 0:
        return "due"
    minutes = seconds // 60
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    if hours < 24:
        return f"{hours}h{minutes % 60:02d}m"
    days = hours // 24
    return f"{days}d{hours % 24:02d}h"


def weekly_percent_text(
    credits: Optional[float],
    calibration: Optional[QuotaCalibration],
    complete: bool = True,
) -> str:
    if credits is None or calibration is None or not calibration.credits_per_percent:
        return "—"
    pct = max(0.0, credits / calibration.credits_per_percent)
    if pct < 0.01 and pct > 0:
        text = "<0.01%"
    elif pct < 10:
        text = f"{pct:.2f}%"
    else:
        text = f"{pct:.1f}%"
    return text if complete else f"≥{text}"


def default_cache_path() -> Path:
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA")
        if base:
            return Path(base) / "codex-usage" / "index-v2.sqlite3"
        return (
            Path.home()
            / "AppData"
            / "Local"
            / "codex-usage"
            / "index-v2.sqlite3"
        )
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Caches" / "codex-usage" / "index-v2.sqlite3"
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return base / "codex-usage" / "index-v2.sqlite3"


def _cache_connect(cache_path: Path) -> sqlite3.Connection:
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(cache_path), timeout=5.0)
    conn.row_factory = sqlite3.Row

    # Platform-tuned profile: the index itself is typically small, so keep a
    # useful SQLite page cache and mmap the *index database only*. Raw rollout
    # JSONL remains sequentially streamed instead of mmap'd.
    if sys.platform == "darwin" and platform.machine().lower() in ("arm64", "aarch64"):
        cache_kib = 128 * 1024
        mmap_bytes = 256 * 1024 * 1024
    elif os.name == "nt":
        cache_kib = 64 * 1024
        mmap_bytes = 128 * 1024 * 1024
    else:
        cache_kib = 32 * 1024
        mmap_bytes = 64 * 1024 * 1024

    for pragma in (
        "PRAGMA journal_mode=WAL",
        "PRAGMA synchronous=NORMAL",
        "PRAGMA temp_store=MEMORY",
        f"PRAGMA cache_size=-{cache_kib}",
        f"PRAGMA mmap_size={mmap_bytes}",
    ):
        try:
            conn.execute(pragma)
        except sqlite3.Error:
            pass

    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS meta (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS files (
            path TEXT PRIMARY KEY,
            dev INTEGER NOT NULL DEFAULT 0,
            ino INTEGER NOT NULL DEFAULT 0,
            observed_size INTEGER NOT NULL DEFAULT 0,
            mtime_ns INTEGER NOT NULL DEFAULT 0,
            offset INTEGER NOT NULL DEFAULT 0,
            session_id TEXT NOT NULL,
            current_model TEXT NOT NULL DEFAULT 'unknown',
            current_service_tier TEXT NOT NULL DEFAULT 'unknown',
            own_meta_seen INTEGER NOT NULL DEFAULT 0,
            created_at TEXT,
            cwd TEXT NOT NULL DEFAULT '',
            source_json TEXT NOT NULL DEFAULT '""',
            thread_source_json TEXT NOT NULL DEFAULT '""',
            originator TEXT NOT NULL DEFAULT '',
            parent_id TEXT NOT NULL DEFAULT '',
            forked_from_id TEXT NOT NULL DEFAULT '',
            model_provider TEXT NOT NULL DEFAULT '',
            malformed_lines INTEGER NOT NULL DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS events (
            path TEXT NOT NULL,
            byte_offset INTEGER NOT NULL,
            ts TEXT NOT NULL,
            model TEXT NOT NULL,
            service_tier TEXT NOT NULL DEFAULT 'unknown',
            input_tokens INTEGER NOT NULL,
            cached_input_tokens INTEGER NOT NULL,
            output_tokens INTEGER NOT NULL,
            reasoning_output_tokens INTEGER NOT NULL,
            total_tokens INTEGER NOT NULL,
            PRIMARY KEY(path, byte_offset)
        );
        CREATE INDEX IF NOT EXISTS events_path_offset ON events(path, byte_offset);
        CREATE INDEX IF NOT EXISTS events_ts ON events(ts);
        CREATE TABLE IF NOT EXISTS quota_observations (
            account_key TEXT NOT NULL,
            plan_type TEXT NOT NULL,
            reset_at INTEGER NOT NULL,
            window_minutes INTEGER NOT NULL,
            snapshot_ts TEXT NOT NULL,
            used_percent REAL NOT NULL,
            local_credits REAL NOT NULL,
            rate_card TEXT NOT NULL,
            credit_mode TEXT NOT NULL,
            source TEXT NOT NULL,
            PRIMARY KEY(account_key, plan_type, reset_at, snapshot_ts, credit_mode)
        );
        CREATE INDEX IF NOT EXISTS quota_obs_lookup
            ON quota_observations(account_key, plan_type, rate_card, credit_mode, reset_at, snapshot_ts);
        CREATE TABLE IF NOT EXISTS quota_snapshots (
            account_key TEXT NOT NULL,
            plan_type TEXT NOT NULL,
            reset_at INTEGER NOT NULL,
            window_minutes INTEGER NOT NULL,
            snapshot_ts TEXT NOT NULL,
            used_percent REAL NOT NULL,
            credit_mode TEXT NOT NULL,
            source TEXT NOT NULL,
            PRIMARY KEY(account_key, plan_type, reset_at, snapshot_ts, credit_mode)
        );
        CREATE INDEX IF NOT EXISTS quota_snapshots_lookup
            ON quota_snapshots(account_key, plan_type, credit_mode, reset_at, used_percent, snapshot_ts);
        CREATE TABLE IF NOT EXISTS quota_intervals (
            account_key TEXT NOT NULL,
            plan_type TEXT NOT NULL,
            reset_at INTEGER NOT NULL,
            start_ts TEXT NOT NULL,
            end_ts TEXT NOT NULL,
            start_used_percent REAL NOT NULL,
            end_used_percent REAL NOT NULL,
            local_credits REAL,
            complete INTEGER NOT NULL,
            rate_card TEXT NOT NULL,
            credit_mode TEXT NOT NULL,
            source TEXT NOT NULL,
            PRIMARY KEY(account_key, plan_type, reset_at, start_ts, end_ts, credit_mode)
        );
        CREATE INDEX IF NOT EXISTS quota_intervals_lookup
            ON quota_intervals(account_key, plan_type, rate_card, credit_mode, reset_at, end_ts);
        """
    )

    # CREATE TABLE IF NOT EXISTS does not add columns to an existing v2
    # cache. Add them before checking the schema version, then clear token/file
    # rows so they are replayed with tier-aware state.
    for table, column, declaration in (
        ("files", "current_service_tier", "TEXT NOT NULL DEFAULT 'unknown'"),
        ("events", "service_tier", "TEXT NOT NULL DEFAULT 'unknown'"),
    ):
        columns = {str(r[1]) for r in conn.execute(f"PRAGMA table_info({table})")}
        if column not in columns:
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} {declaration}")

    row = conn.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
    if row is not None and int(row[0]) != CACHE_SCHEMA_VERSION:
        conn.executescript("DELETE FROM events; DELETE FROM files; DELETE FROM meta;")
    conn.execute(
        "INSERT OR REPLACE INTO meta(key,value) VALUES('schema_version',?)",
        (str(CACHE_SCHEMA_VERSION),),
    )
    conn.commit()
    return conn


def _json_text(value: object) -> str:
    try:
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    except (TypeError, ValueError):
        return json.dumps(str(value), ensure_ascii=False)


def _json_value(value: object) -> object:
    if value is None:
        return ""
    try:
        return json.loads(str(value))
    except (json.JSONDecodeError, TypeError, ValueError):
        return str(value)


def _session_from_cache_row(row: sqlite3.Row, path: Path) -> RawSession:
    return RawSession(
        session_id=str(row["session_id"]),
        path=path,
        created_at=parse_ts(row["created_at"]),
        cwd=str(row["cwd"] or ""),
        source=_json_value(row["source_json"]),
        thread_source=_json_value(row["thread_source_json"]),
        originator=str(row["originator"] or ""),
        parent_id=str(row["parent_id"] or ""),
        forked_from_id=str(row["forked_from_id"] or ""),
        model_provider=str(row["model_provider"] or ""),
        malformed_lines=int(row["malformed_lines"] or 0),
    )


def _scan_file_into_cache(
    conn: sqlite3.Connection,
    path: Path,
    stats: CacheStats,
    force_reset: bool = False,
) -> None:
    p = str(path)
    try:
        st = path.stat()
    except OSError:
        return

    row = conn.execute("SELECT * FROM files WHERE path=?", (p,)).fetchone()
    reset = force_reset
    start_offset = 0
    current_model = "unknown"
    current_service_tier = SERVICE_TIER_UNKNOWN
    own_meta_seen = False

    if row is not None and not force_reset:
        same_identity = (
            int(row["dev"]) == _sqlite_i64(st.st_dev)
            and int(row["ino"]) == _sqlite_i64(st.st_ino)
        )
        old_size = int(row["observed_size"])
        old_offset = int(row["offset"])
        same_snapshot = (
            same_identity
            and old_size == int(st.st_size)
            and int(row["mtime_ns"]) == int(st.st_mtime_ns)
            and old_offset >= int(st.st_size)
        )
        if same_snapshot:
            stats.cache_hits += 1
            return

        append_only = same_identity and int(st.st_size) >= old_size
        if int(st.st_size) == old_size and int(st.st_mtime_ns) != int(row["mtime_ns"]):
            append_only = False
        if append_only:
            start_offset = min(old_offset, int(st.st_size))
            current_model = str(row["current_model"] or "unknown")
            current_service_tier = str(row["current_service_tier"] or SERVICE_TIER_UNKNOWN)
            own_meta_seen = bool(row["own_meta_seen"])
            session = _session_from_cache_row(row, path)
            stats.incremental_scans += 1
        else:
            reset = True
    else:
        session = RawSession(session_id=id_from_filename(path), path=path)
        stats.cold_scans += 1

    if reset:
        conn.execute("DELETE FROM events WHERE path=?", (p,))
        conn.execute("DELETE FROM files WHERE path=?", (p,))
        session = RawSession(session_id=id_from_filename(path), path=path)
        start_offset = 0
        current_model = "unknown"
        current_service_tier = SERVICE_TIER_UNKNOWN
        own_meta_seen = False
        if row is not None:
            stats.cold_scans += 1

    last_complete_offset = start_offset
    try:
        fh = path.open("rb", buffering=4 * 1024 * 1024)
    except OSError:
        return

    with fh:
        fh.seek(start_offset)
        while True:
            line_start = fh.tell()
            raw = fh.readline()
            if not raw:
                break
            stats.bytes_read += len(raw)
            if not raw.endswith(b"\n"):
                break
            last_complete_offset = fh.tell()
            if not raw.startswith(b"{") or not _line_is_relevant(raw):
                continue
            try:
                rec = json.loads(raw)
            except (json.JSONDecodeError, UnicodeDecodeError, MemoryError):
                session.malformed_lines += 1
                continue
            stats.parsed_records += 1
            current_model, current_service_tier, own_meta_seen, event = _apply_record(
                session, rec, current_model, current_service_tier, own_meta_seen
            )
            if event is not None:
                u = event.cumulative
                conn.execute(
                    """
                    INSERT OR REPLACE INTO events(
                        path,byte_offset,ts,model,service_tier,input_tokens,cached_input_tokens,
                        output_tokens,reasoning_output_tokens,total_tokens
                    ) VALUES(?,?,?,?,?,?,?,?,?,?)
                    """,
                    (
                        p, line_start, event.ts.astimezone(timezone.utc).isoformat(), event.model,
                        event.service_tier, u.input_tokens, u.cached_input_tokens, u.output_tokens,
                        u.reasoning_output_tokens, u.total_tokens,
                    ),
                )

    try:
        st2 = path.stat()
    except OSError:
        st2 = st

    if session.created_at is None:
        first = conn.execute(
            "SELECT ts FROM events WHERE path=? ORDER BY byte_offset LIMIT 1", (p,)
        ).fetchone()
        if first is not None:
            session.created_at = parse_ts(first[0])

    conn.execute(
        """
        INSERT OR REPLACE INTO files(
            path,dev,ino,observed_size,mtime_ns,offset,session_id,current_model,
            current_service_tier,own_meta_seen,created_at,cwd,source_json,thread_source_json,originator,
            parent_id,forked_from_id,model_provider,malformed_lines
        ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
        """,
        (
            p, _sqlite_i64(st2.st_dev), _sqlite_i64(st2.st_ino), int(st2.st_size), int(st2.st_mtime_ns),
            int(last_complete_offset), session.session_id, current_model, current_service_tier,
            1 if own_meta_seen else 0,
            session.created_at.astimezone(timezone.utc).isoformat() if session.created_at else None,
            session.cwd, _json_text(session.source), _json_text(session.thread_source),
            session.originator, session.parent_id, session.forked_from_id,
            session.model_provider, session.malformed_lines,
        ),
    )


def _prune_missing_cache_files(conn: sqlite3.Connection, live_paths: set) -> None:
    stale = []
    for row in conn.execute("SELECT path FROM files"):
        if str(row[0]) not in live_paths:
            stale.append(str(row[0]))
    for p in stale:
        conn.execute("DELETE FROM events WHERE path=?", (p,))
        conn.execute("DELETE FROM files WHERE path=?", (p,))


def _load_sessions_from_cache(conn: sqlite3.Connection, live_paths: set) -> Dict[str, RawSession]:
    sessions: Dict[str, RawSession] = {}
    rows = list(conn.execute("SELECT * FROM files ORDER BY mtime_ns"))
    for row in rows:
        p = str(row["path"])
        if p not in live_paths:
            continue
        session = _session_from_cache_row(row, Path(p))
        for erow in conn.execute(
            """
            SELECT ts,model,service_tier,input_tokens,cached_input_tokens,output_tokens,
                   reasoning_output_tokens,total_tokens
            FROM events WHERE path=? ORDER BY byte_offset
            """,
            (p,),
        ):
            ts = parse_ts(erow["ts"])
            if ts is None:
                continue
            session.usage_events.append(
                UsageEvent(
                    ts=ts,
                    model=str(erow["model"]),
                    service_tier=str(erow["service_tier"] or SERVICE_TIER_UNKNOWN),
                    cumulative=Usage(
                        input_tokens=int(erow["input_tokens"]),
                        cached_input_tokens=int(erow["cached_input_tokens"]),
                        output_tokens=int(erow["output_tokens"]),
                        reasoning_output_tokens=int(erow["reasoning_output_tokens"]),
                        total_tokens=int(erow["total_tokens"]),
                    ),
                )
            )
        if session.created_at is None and session.usage_events:
            session.created_at = session.usage_events[0].ts
        sessions[session.session_id] = session
    return sessions


def _ensure_relevant_ancestors(
    conn: sqlite3.Connection,
    paths: List[Path],
    start: datetime,
    end: datetime,
    stats: CacheStats,
) -> None:
    # Build cheap filename-ID lookup without reading file contents.
    by_id = {id_from_filename(p): p for p in paths}
    start_utc = start.astimezone(timezone.utc).isoformat()
    end_utc = end.astimezone(timezone.utc).isoformat()
    relevant_paths = {
        str(r[0]) for r in conn.execute(
            "SELECT DISTINCT path FROM events WHERE ts>=? AND ts<?", (start_utc, end_utc)
        )
    }

    queue = list(relevant_paths)
    seen = set(queue)
    while queue:
        p = queue.pop()
        row = conn.execute("SELECT parent_id,forked_from_id FROM files WHERE path=?", (p,)).fetchone()
        if row is None:
            continue
        parent_id = str(row[0] or row[1] or "")
        if not parent_id:
            continue
        parent_path = by_id.get(parent_id)
        if parent_path is None:
            continue
        pp = str(parent_path)
        cached = conn.execute("SELECT 1 FROM files WHERE path=?", (pp,)).fetchone()
        if cached is None:
            # If this ancestor was previously counted as "skipped old" during
            # the same full discovery, move it into the cold/ancestor bucket so
            # Perf categories remain mutually exclusive.
            try:
                pst = parent_path.stat()
                if pst.st_mtime < start.timestamp() and stats.skipped_old_uncached > 0:
                    stats.skipped_old_uncached -= 1
            except OSError:
                pass
            stats.ancestor_scans += 1
            _scan_file_into_cache(conn, parent_path, stats)
        if pp not in seen:
            seen.add(pp)
            queue.append(pp)


def sync_incremental_cache(
    conn: sqlite3.Connection,
    paths: List[Path],
    start: datetime,
    end: datetime,
    rebuild: bool,
) -> CacheStats:
    stats = CacheStats(discovered_files=len(paths))
    t0 = time.perf_counter()

    if rebuild:
        conn.execute("DELETE FROM events")
        conn.execute("DELETE FROM files")
        conn.commit()

    live_paths = {str(p) for p in paths}
    _prune_missing_cache_files(conn, live_paths)

    start_epoch = start.timestamp()
    for path in paths:
        try:
            st = path.stat()
        except OSError:
            continue
        row = conn.execute(
            "SELECT observed_size,mtime_ns,offset,dev,ino FROM files WHERE path=?",
            (str(path),),
        ).fetchone()

        if rebuild:
            _scan_file_into_cache(conn, path, stats)
            continue

        if row is not None:
            unchanged = (
                int(row["observed_size"]) == int(st.st_size)
                and int(row["mtime_ns"]) == int(st.st_mtime_ns)
                and int(row["offset"]) >= int(st.st_size)
                and int(row["dev"]) == _sqlite_i64(st.st_dev)
                and int(row["ino"]) == _sqlite_i64(st.st_ino)
            )
            if unchanged:
                stats.cache_hits += 1
                continue
            # Changed cache entries only need syncing if the file could have
            # activity in/after the requested window. Otherwise defer I/O.
            if st.st_mtime < start_epoch:
                continue
            _scan_file_into_cache(conn, path, stats)
        else:
            # Cold first-run optimization: an unindexed file whose *last* write
            # predates the report start cannot contribute usage to this window.
            if st.st_mtime < start_epoch:
                stats.skipped_old_uncached += 1
                continue
            _scan_file_into_cache(conn, path, stats)

    conn.commit()
    _ensure_relevant_ancestors(conn, paths, start, end, stats)
    conn.commit()
    stats.elapsed_s = time.perf_counter() - t0
    return stats


def cache_info(conn: sqlite3.Connection, cache_path: Path) -> str:
    files_n = int(conn.execute("SELECT COUNT(*) FROM files").fetchone()[0])
    events_n = int(conn.execute("SELECT COUNT(*) FROM events").fetchone()[0])
    quota_n = int(conn.execute("SELECT COUNT(*) FROM quota_observations").fetchone()[0])
    try:
        size = cache_path.stat().st_size
    except OSError:
        size = 0
    machine = f"{platform.system()} {platform.machine()}"
    return (
        f"Cache: {cache_path}\n"
        f"Indexed rollouts: {files_n}\n"
        f"Token events: {events_n}\n"
        f"Quota observations: {quota_n}\n"
        f"DB size: {size / (1024 * 1024):.2f} MiB\n"
        f"Runtime profile: {machine}"
    )



def _record_quota_observation(
    conn: sqlite3.Connection,
    auth: LocalAuthContext,
    snapshot: QuotaSnapshot,
    local_credits: float,
    fast: bool,
) -> None:
    if snapshot.resets_at is None or not (0.0 <= snapshot.used_percent <= 100.0):
        return
    plan = (snapshot.plan_type or auth.plan_type or "unknown").lower()
    mode = _quota_mode(fast)
    conn.execute(
        """
        INSERT OR REPLACE INTO quota_observations(
            account_key,plan_type,reset_at,window_minutes,snapshot_ts,
            used_percent,local_credits,rate_card,credit_mode,source
        ) VALUES(?,?,?,?,?,?,?,?,?,?)
        """,
        (
            auth.account_key,
            plan,
            int(snapshot.resets_at),
            int(snapshot.window_minutes),
            snapshot.ts.astimezone(timezone.utc).isoformat(),
            float(snapshot.used_percent),
            float(local_credits),
            RATE_CARD_CALIBRATION_KEY,
            mode,
            snapshot.source,
        ),
    )
    conn.commit()


def _legacy_rebase_candidates(
    conn: sqlite3.Connection,
    auth: LocalAuthContext,
    snapshot: QuotaSnapshot,
    fast: bool,
    limit: int = 8,
) -> List[QuotaSnapshot]:
    """Return prior-rate anchors from the current weekly reset epoch.

    These anchors carry authoritative backend used-percent/timestamps, but their
    stored local_credits were computed under an older rate card. v1.5.2 never
    reuses those old credit totals directly; callers may replay local token
    history through the *current* rate card and persist a rebased observation.
    """
    if snapshot.resets_at is None:
        return []
    plan = (snapshot.plan_type or auth.plan_type or "unknown").lower()
    mode = _quota_mode(fast)
    legacy_mode = "fast" if fast else "standard"
    rows = list(conn.execute(
        """
        SELECT snapshot_ts,used_percent,reset_at,window_minutes
        FROM quota_observations
        WHERE account_key=? AND plan_type=? AND credit_mode IN (?,?)
          AND rate_card<>? AND snapshot_ts<=?
        ORDER BY snapshot_ts DESC
        LIMIT ?
        """,
        (
            auth.account_key,
            plan,
            mode,
            legacy_mode,
            RATE_CARD_CALIBRATION_KEY,
            snapshot.ts.astimezone(timezone.utc).isoformat(),
            max(1, int(limit)),
        ),
    ))
    out: List[QuotaSnapshot] = []
    for row in rows:
        ts = parse_ts(row["snapshot_ts"])
        if ts is None or ts > snapshot.ts + timedelta(seconds=5):
            continue
        try:
            used = float(row["used_percent"])
            reset_at = int(row["reset_at"])
            window_minutes = int(row["window_minutes"])
        except (TypeError, ValueError):
            continue
        if not (1.0 <= used <= 100.0) or window_minutes <= 0:
            continue
        out.append(QuotaSnapshot(
            ts=ts,
            used_percent=used,
            window_minutes=window_minutes,
            resets_at=reset_at,
            plan_type=plan,
            limit_id=snapshot.limit_id,
            source="rebased",
        ))
    return out


def _try_rebase_legacy_observation(
    conn: sqlite3.Connection,
    auth: LocalAuthContext,
    snapshot: QuotaSnapshot,
    sessions: Dict[str, RawSession],
    index: Dict[str, dict],
    tz,
    fast: bool,
) -> Optional[QuotaSnapshot]:
    """Re-price a prior backend anchor under the current rate card.

    Candidates are tried newest-first. If an anchor interval contains any
    unpriced usage (for example GPT-5.3-Codex-Spark), it is skipped rather than
    turning a lower bound into a fake complete baseline. The first fully priced
    replay is stored as a normal current-revision observation with source
    ``rebased`` so future current-rate deltas share one consistent coordinate
    system.
    """
    for anchor in _legacy_rebase_candidates(conn, auth, snapshot, fast):
        start = quota_window_start(anchor, tz)
        end = _to_tz(anchor.ts, tz) + timedelta(microseconds=1)
        if start is None or end <= start:
            continue
        buckets = make_buckets(
            sessions=sessions,
            index=index,
            start=start,
            end=end,
            tz=tz,
            show_subagents=False,
            trend_start=None,
        )
        credits, complete = bucket_collection_credits(buckets, sessions, fast)
        if credits is None or not complete:
            continue
        _record_quota_observation(conn, auth, anchor, credits, fast)
        return anchor
    return None


def _quota_mode(fast: bool) -> str:
    return "tier_auto_assume_fast" if fast else "tier_auto"


def _quota_plan(auth: LocalAuthContext, snapshot: QuotaSnapshot) -> str:
    return (snapshot.plan_type or auth.plan_type or "unknown").lower()


def _record_quota_snapshot(
    conn: sqlite3.Connection,
    auth: LocalAuthContext,
    snapshot: QuotaSnapshot,
    fast: bool,
) -> None:
    if snapshot.resets_at is None:
        return
    conn.execute(
        """
        INSERT OR REPLACE INTO quota_snapshots(
            account_key,plan_type,reset_at,window_minutes,snapshot_ts,
            used_percent,credit_mode,source
        ) VALUES(?,?,?,?,?,?,?,?)
        """,
        (
            auth.account_key,
            _quota_plan(auth, snapshot),
            int(snapshot.resets_at),
            int(snapshot.window_minutes),
            snapshot.ts.astimezone(timezone.utc).isoformat(),
            float(snapshot.used_percent),
            _quota_mode(fast),
            snapshot.source,
        ),
    )
    conn.commit()


def _quota_interval_anchor(
    conn: sqlite3.Connection,
    auth: LocalAuthContext,
    snapshot: QuotaSnapshot,
    fast: bool,
) -> Optional[QuotaSnapshot]:
    """Return the earliest snapshot on the nearest lower usage plateau.

    Backend used-percent values are commonly rounded. Using the earliest sample
    on the previous plateau captures the work accumulated while the displayed
    percentage stayed flat, instead of learning from only the last tiny slice
    immediately before a 1pp jump.
    """
    if snapshot.resets_at is None or snapshot.used_percent <= 0:
        return None
    plan = _quota_plan(auth, snapshot)
    mode = _quota_mode(fast)
    prev = conn.execute(
        """
        SELECT MAX(used_percent) AS used
        FROM quota_snapshots
        WHERE account_key=? AND plan_type=? AND reset_at=? AND credit_mode=?
          AND used_percent < ?
        """,
        (auth.account_key, plan, int(snapshot.resets_at), mode, float(snapshot.used_percent) - 1e-9),
    ).fetchone()
    if prev is None or prev["used"] is None:
        return None
    prev_used = float(prev["used"])
    row = conn.execute(
        """
        SELECT snapshot_ts,window_minutes,source
        FROM quota_snapshots
        WHERE account_key=? AND plan_type=? AND reset_at=? AND credit_mode=?
          AND ABS(used_percent-?) < 1e-9
        ORDER BY snapshot_ts ASC LIMIT 1
        """,
        (auth.account_key, plan, int(snapshot.resets_at), mode, prev_used),
    ).fetchone()
    if row is None:
        return None
    ts = parse_ts(row["snapshot_ts"])
    if ts is None or ts >= snapshot.ts:
        return None
    return QuotaSnapshot(
        ts=ts,
        used_percent=prev_used,
        window_minutes=int(row["window_minutes"]),
        resets_at=int(snapshot.resets_at),
        plan_type=plan,
        limit_id=snapshot.limit_id,
        source=str(row["source"] or "snapshot"),
    )


def _record_quota_interval(
    conn: sqlite3.Connection,
    auth: LocalAuthContext,
    start_snapshot: QuotaSnapshot,
    end_snapshot: QuotaSnapshot,
    local_credits: Optional[float],
    complete: bool,
    fast: bool,
) -> None:
    if end_snapshot.resets_at is None or start_snapshot.resets_at != end_snapshot.resets_at:
        return
    conn.execute(
        """
        INSERT OR REPLACE INTO quota_intervals(
            account_key,plan_type,reset_at,start_ts,end_ts,start_used_percent,
            end_used_percent,local_credits,complete,rate_card,credit_mode,source
        ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)
        """,
        (
            auth.account_key,
            _quota_plan(auth, end_snapshot),
            int(end_snapshot.resets_at),
            start_snapshot.ts.astimezone(timezone.utc).isoformat(),
            end_snapshot.ts.astimezone(timezone.utc).isoformat(),
            float(start_snapshot.used_percent),
            float(end_snapshot.used_percent),
            None if local_credits is None else float(local_credits),
            1 if complete else 0,
            RATE_CARD_CALIBRATION_KEY,
            _quota_mode(fast),
            "snapshot_delta",
        ),
    )
    conn.commit()


def bootstrap_quota_calibration(
    auth: LocalAuthContext,
    snapshot: QuotaSnapshot,
) -> QuotaCalibration:
    plan = _quota_plan(auth, snapshot)
    cpp = PLAN_WEEKLY_SEED_CPP.get(plan, PLAN_WEEKLY_SEED_CPP["prolite"])
    return QuotaCalibration(
        credits_per_percent=cpp,
        confidence="SEED",
        source="plan_seed" if plan in PLAN_WEEKLY_SEED_CPP else "generic_seed",
    )


def _weighted_median(values: List[Tuple[float, float]]) -> Optional[float]:
    if not values:
        return None
    ordered = sorted((float(v), max(0.0, float(w))) for v, w in values if v > 0 and w > 0)
    if not ordered:
        return None
    total = sum(w for _, w in ordered)
    halfway = total / 2.0
    running = 0.0
    for value, weight in ordered:
        running += weight
        if running >= halfway:
            return value
    return ordered[-1][0]


def load_quota_calibration(
    conn: sqlite3.Connection,
    auth: LocalAuthContext,
    snapshot: QuotaSnapshot,
    current_local_credits: Optional[float],
    fast: bool,
) -> QuotaCalibration:
    plan = (snapshot.plan_type or auth.plan_type or "unknown").lower()
    mode = _quota_mode(fast)
    rows = list(conn.execute(
        """
        SELECT reset_at,snapshot_ts,used_percent,local_credits,source
        FROM quota_observations
        WHERE account_key=? AND plan_type=? AND rate_card=? AND credit_mode=?
        ORDER BY reset_at,snapshot_ts
        """,
        (auth.account_key, plan, RATE_CARD_CALIBRATION_KEY, mode),
    ))
    calibration = QuotaCalibration(observation_count=len(rows))

    interval_rows = list(conn.execute(
        """
        SELECT start_used_percent,end_used_percent,local_credits
        FROM quota_intervals
        WHERE account_key=? AND plan_type=? AND rate_card=? AND credit_mode=?
          AND complete=1 AND local_credits IS NOT NULL
        ORDER BY reset_at,end_ts
        """,
        (auth.account_key, plan, RATE_CARD_CALIBRATION_KEY, mode),
    ))
    calibration.observation_count = len(rows) + len(interval_rows)
    candidates: List[Tuple[float, float]] = []
    for row in interval_rows:
        du = float(row["end_used_percent"]) - float(row["start_used_percent"])
        dc = float(row["local_credits"])
        if du >= 0.25 and dc > 0:
            ratio = dc / du
            if 0 < ratio < 1e9:
                candidates.append((ratio, du))

    if not candidates:
        by_reset: Dict[int, List[sqlite3.Row]] = {}
        for row in rows:
            by_reset.setdefault(int(row["reset_at"]), []).append(row)
        for group in by_reset.values():
            for previous, current in zip(group, group[1:]):
                du = float(current["used_percent"]) - float(previous["used_percent"])
                dc = float(current["local_credits"]) - float(previous["local_credits"])
                if du < 0.25 or dc <= 0:
                    continue
                ratio = dc / du
                if 0 < ratio < 1e9:
                    candidates.append((ratio, du))

    clean = candidates
    if len(candidates) >= 2:
        ratios = sorted(value for value, _ in candidates)
        upper_half = ratios[len(ratios) // 2:]
        high_center = statistics.median(upper_half)
        # Unexplained external agentic usage makes local credits / backend pp
        # abnormally small. Very large values are usually rounding intervals.
        lower = high_center * 0.55
        upper = high_center * 1.80
        filtered = [(value, weight) for value, weight in candidates if lower <= value <= upper]
        if filtered:
            clean = filtered

    cpp = _weighted_median(clean)
    source = "delta" if cpp is not None else ""
    observed_pp = sum(weight for _, weight in clean)

    # Prefer a complete current observation for the initial baseline. If the
    # current weekly window contains an unpriced model (for example Spark), do
    # not throw away an already learned calibration just because this run cannot
    # create a new complete observation.
    if cpp is None and current_local_credits is not None and snapshot.used_percent >= 1.0:
        cpp = current_local_credits / snapshot.used_percent
        if cpp > 0:
            source = "baseline"
        else:
            cpp = None

    if cpp is None and rows:
        latest = rows[-1]
        used = float(latest["used_percent"])
        stored_credits = float(latest["local_credits"])
        if used >= 1.0 and stored_credits > 0:
            cpp = stored_credits / used
            same_epoch = int(latest["reset_at"]) == int(snapshot.resets_at or -1)
            if str(latest["source"] or "") == "rebased":
                source = "rebased_baseline" if same_epoch else "historical_rebased"
            else:
                source = "stored_baseline" if same_epoch else "historical_baseline"

    # v1.5.2 deliberately does NOT fall back to old-rate local_credits. Those
    # values live in a different coordinate system after a rate-card change.
    # main() may replay a legacy backend anchor through the current rate card;
    # if no fully priced anchor can be rebased, remain LEARNING rather than
    # publishing a numerically incompatible WEEKLY≈ conversion.

    calibration.credits_per_percent = cpp
    calibration.clean_intervals = len(clean) if source == "delta" else 0
    calibration.observed_percent_points = observed_pp if source == "delta" else 0.0
    calibration.source = source

    if cpp is None:
        calibration.confidence = "LEARNING"
        return calibration

    if source != "delta" or len(clean) < 2 or observed_pp < 3.0:
        calibration.confidence = "LOW"
    else:
        ratios = [value for value, _ in clean]
        mad = statistics.median(abs(value - statistics.median(ratios)) for value in ratios)
        relative_mad = mad / cpp if cpp > 0 else 1.0
        if len(clean) >= 5 and observed_pp >= 8.0 and relative_mad <= 0.25:
            calibration.confidence = "HIGH"
        else:
            calibration.confidence = "MEDIUM"

    # Coverage is only independently meaningful after delta calibration. A
    # baseline is defined from local_credits / used_percent and would therefore
    # report 100% by construction.
    if (
        source == "delta"
        and current_local_credits is not None
        and snapshot.used_percent > 0
        and cpp > 0
    ):
        local_used_pp = current_local_credits / cpp
        calibration.local_coverage_percent = 100.0 * local_used_pp / snapshot.used_percent
    return calibration


def _clean_thread_label(value: object) -> str:
    return " ".join(str(value or "").split())


def _cwd_project_label(raw_cwd: object) -> str:
    cwd = str(raw_cwd or "").strip()
    if not cwd:
        return ""
    try:
        # A report may be rendered on a different OS from the recorded cwd.
        if re.match(r"^[A-Za-z]:[\\/]", cwd) or cwd.startswith("\\\\"):
            leaf = PureWindowsPath(cwd).name
        else:
            leaf = Path(cwd).expanduser().name
    except (OSError, ValueError):
        leaf = ""
    return _clean_thread_label(leaf)


def _git_origin_project_label(raw_url: object) -> str:
    value = str(raw_url or "").strip().rstrip("/")
    if not value:
        return ""
    tail = value.rsplit("/", 1)[-1]
    if ":" in tail and "/" not in value:
        tail = tail.rsplit(":", 1)[-1]
    if tail.endswith(".git"):
        tail = tail[:-4]
    return _clean_thread_label(tail)


def _path_is_within(cwd: str, root: str) -> bool:
    try:
        cwd_norm = os.path.normcase(os.path.abspath(os.path.expanduser(cwd)))
        root_norm = os.path.normcase(os.path.abspath(os.path.expanduser(root)))
        return os.path.commonpath((cwd_norm, root_norm)) == root_norm
    except (OSError, ValueError):
        return False


def load_thread_index(codex_home: Path) -> Dict[str, dict]:
    """Best-effort read of Codex thread names, projects, titles, and cwd.

    Current Codex state databases distinguish an explicit user-facing thread
    ``name`` from the generated ``title``/``preview`` and may assign a thread to
    a named project. Older schemas remain supported through dynamic column and
    table discovery.
    """
    db = codex_home / "state_5.sqlite"
    if not db.exists():
        return {}

    result: Dict[str, dict] = {}
    try:
        conn = sqlite3.connect(_sqlite_ro_uri(db), uri=True, timeout=1.0)
    except (sqlite3.Error, OSError):
        return {}

    try:
        tables = {
            str(row[0])
            for row in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        if "threads" not in tables:
            return {}
        cols = [str(row[1]) for row in conn.execute("PRAGMA table_info(threads)")]
        if "id" not in cols:
            return {}
        wanted = [
            c for c in (
                "id", "name", "title", "preview", "first_user_message",
                "project_id", "cwd", "source", "thread_source", "agent_nickname",
                "agent_role", "model_provider", "created_at", "updated_at",
                "rollout_path", "git_origin_url", "git_branch",
            ) if c in cols
        ]

        project_names: Dict[str, str] = {}
        if "projects" in tables:
            project_cols = {
                str(row[1]) for row in conn.execute("PRAGMA table_info(projects)")
            }
            if {"id", "name"}.issubset(project_cols):
                for project_id, project_name in conn.execute("SELECT id,name FROM projects"):
                    pid = str(project_id or "")
                    name = _clean_thread_label(project_name)
                    if pid and name:
                        project_names[pid] = name

        project_roots: List[Tuple[str, str, str]] = []
        if "project_roots" in tables and project_names:
            root_cols = {
                str(row[1]) for row in conn.execute("PRAGMA table_info(project_roots)")
            }
            if {"project_id", "path"}.issubset(root_cols):
                for project_id, root_path in conn.execute(
                    "SELECT project_id,path FROM project_roots"
                ):
                    pid = str(project_id or "")
                    root = str(root_path or "").strip()
                    name = project_names.get(pid, "")
                    if pid and root and name:
                        project_roots.append((pid, name, root))
                project_roots.sort(key=lambda item: len(item[2]), reverse=True)

        q = "SELECT " + ", ".join(
            '"' + c.replace('"', '""') + '"' for c in wanted
        ) + ' FROM "threads"'
        for row in conn.execute(q):
            item = dict(zip(wanted, row))
            sid = str(item.get("id") or "")
            if not sid:
                continue
            project_id = str(item.get("project_id") or "")
            project_name = project_names.get(project_id, "")
            if not project_name:
                cwd = str(item.get("cwd") or "")
                for inferred_id, inferred_name, root in project_roots:
                    if _path_is_within(cwd, root):
                        project_id = inferred_id
                        project_name = inferred_name
                        break
            item["project_id"] = project_id
            item["project_name"] = project_name
            result[sid] = item
    except sqlite3.Error:
        pass
    finally:
        conn.close()
    return result


def session_label_metadata(session: RawSession, index: Dict[str, dict]) -> Dict[str, str]:
    dbrow = index.get(session.session_id, {})
    explicit_name = _clean_thread_label(dbrow.get("name"))
    preview = _clean_thread_label(dbrow.get("preview"))
    generated_title = _clean_thread_label(dbrow.get("title"))
    first_user_message = _clean_thread_label(dbrow.get("first_user_message"))
    agent_nickname = _clean_thread_label(dbrow.get("agent_nickname"))
    agent_role = _clean_thread_label(dbrow.get("agent_role"))

    if session.is_subagent() and not explicit_name:
        if agent_nickname and agent_role:
            explicit_name = f"{agent_nickname} ({agent_role})"
        else:
            explicit_name = agent_nickname or agent_role

    thread_title = preview or generated_title or first_user_message
    base = explicit_name or thread_title

    project_id = str(dbrow.get("project_id") or "")
    project_name = _clean_thread_label(dbrow.get("project_name"))
    cwd = str(dbrow.get("cwd") or session.cwd or "").strip()
    repo_name = _git_origin_project_label(dbrow.get("git_origin_url"))
    # The concrete cwd is usually more discriminative than the shared remote
    # repository name (for example across worktrees). A canonical Codex project
    # still takes precedence when one is assigned.
    context = project_name or _cwd_project_label(cwd) or repo_name
    resolved_project = context

    if not base:
        base = context or session.session_id[:12]
        context = ""

    normalized_base = base.casefold().strip()
    normalized_context = context.casefold().strip()
    already_contextualized = bool(
        context
        and (
            normalized_base == normalized_context
            or normalized_base.startswith(f"[{normalized_context}]")
            or normalized_base.startswith(normalized_context + " ·")
            or normalized_base.startswith(normalized_context + ":")
        )
    )
    display_title = (
        f"[{context}] {base}" if context and not already_contextualized else base
    )
    return {
        "display_title": display_title,
        "session_name": explicit_name,
        "thread_title": thread_title,
        "project_id": project_id,
        "project_name": resolved_project,
        "cwd": cwd,
    }


def session_title(session: RawSession, index: Dict[str, dict]) -> str:
    return session_label_metadata(session, index)["display_title"]


def _disambiguate_bucket_titles(buckets: Dict[str, Bucket]) -> None:
    """Give exact duplicate labels a stable marker that survives truncation."""
    grouped: Dict[str, List[Bucket]] = {}
    for bucket in buckets.values():
        key = _clean_thread_label(bucket.title).casefold()
        grouped.setdefault(key, []).append(bucket)
    for group in grouped.values():
        if len(group) < 2:
            continue
        for bucket in group:
            compact_id = bucket.session_id.replace("-", "")
            marker = f"#{compact_id[-6:]}" if compact_id else "#dup"
            # Keep project context first, then insert the marker before the
            # long prompt/name so a narrow SESSION column still distinguishes it.
            if bucket.title.startswith("[") and "]" in bucket.title:
                close = bucket.title.find("]") + 1
                prefix = bucket.title[:close]
                rest = bucket.title[close:].lstrip()
                bucket.title = f"{prefix} {marker} {rest}" if rest else f"{prefix} {marker}"
            else:
                bucket.title = f"{marker} {bucket.title}"


def get_tz(name: Optional[str]):
    if name:
        try:
            return ZoneInfo(name)
        except ZoneInfoNotFoundError:
            hint = ""
            if os.name == "nt":
                hint = (
                    " Windows does not ship the IANA time-zone database with "
                    "Python; either omit --timezone to use the Windows system "
                    "time zone, or install the optional 'tzdata' package."
                )
            raise SystemExit(f"Unknown timezone: {name}.{hint}")
    # None is intentional: datetime.astimezone() with no argument asks the OS
    # for the local zone at the timestamp being converted. This works on
    # Windows without the optional IANA tzdata package and respects local DST.
    return None


def _now_in_tz(tz) -> datetime:
    return datetime.now(tz) if tz is not None else datetime.now().astimezone()


def _to_tz(dt: datetime, tz) -> datetime:
    return dt.astimezone(tz) if tz is not None else dt.astimezone()


def _localize_wall_time(dt: datetime, tz) -> datetime:
    if tz is not None:
        return dt.replace(tzinfo=tz)
    # A naive datetime passed to astimezone() is interpreted as system local
    # time, letting Windows/macOS/Linux supply the appropriate historical offset.
    return dt.astimezone()


def _tz_label(tz) -> str:
    if tz is not None:
        return getattr(tz, "key", None) or str(tz)
    local = datetime.now().astimezone()
    return local.tzname() or "local"


def _tz_display(tz, now: datetime) -> str:
    """Human-readable zone label with an unambiguous UTC offset."""
    label = _tz_label(tz)
    current = now.astimezone(tz) if tz is not None else now.astimezone()
    off = current.utcoffset()
    if off is None:
        return label
    total = int(off.total_seconds())
    sign = "+" if total >= 0 else "-"
    total = abs(total)
    hours, rem = divmod(total, 3600)
    minutes = rem // 60
    return f"{label} (UTC{sign}{hours:02d}:{minutes:02d})"


def parse_period(spec: str, tz) -> Tuple[datetime, datetime, str]:
    now = _now_in_tz(tz)
    today = now.date()
    s = spec.strip().lower()

    # Rolling wall-clock windows, e.g. 6h / 12h / 24h / 48h.
    # Unlike today/yesterday, these are exact "now minus N hours" intervals.
    m = re.fullmatch(r"(\d+)h", s)
    if m:
        hours = int(m.group(1))
        if hours <= 0:
            raise SystemExit("Rolling hour window must be greater than 0h.")
        if hours > 24 * 365:
            raise SystemExit("Rolling hour window is limited to 8760h (365 days).")
        end_dt = now
        start_utc = now.astimezone(timezone.utc) - timedelta(hours=hours)
        start_dt = _to_tz(start_utc, tz)
        label = (
            f"last {hours}h "
            f"({start_dt.strftime('%Y-%m-%d %H:%M')} → "
            f"{end_dt.strftime('%Y-%m-%d %H:%M')})"
        )
        return start_dt, end_dt, label

    if s == "today":
        start_d, end_d = today, today + timedelta(days=1)
        label = today.isoformat()
    elif s == "yesterday":
        start_d, end_d = today - timedelta(days=1), today
        label = start_d.isoformat()
    elif s == "week":
        # Calendar week to date, Monday through now/today.
        start_d = today - timedelta(days=today.weekday())
        end_d = today + timedelta(days=1)
        label = f"{start_d.isoformat()}..{today.isoformat()} (week-to-date)"
    elif s in ("7d", "last7", "last-7-days"):
        # Kept for backward compatibility: 7 calendar dates including today.
        # Use 168h when an exact rolling seven-day window is desired.
        start_d = today - timedelta(days=6)
        end_d = today + timedelta(days=1)
        label = f"{start_d.isoformat()}..{today.isoformat()} (7 calendar days)"
    elif ".." in s:
        a, b = s.split("..", 1)
        try:
            start_d = date.fromisoformat(a)
            last_d = date.fromisoformat(b)
        except ValueError as exc:
            raise SystemExit(f"Invalid date range: {spec}") from exc
        if last_d < start_d:
            raise SystemExit("Range end must be on/after range start.")
        end_d = last_d + timedelta(days=1)
        label = f"{start_d.isoformat()}..{last_d.isoformat()}"
    else:
        try:
            start_d = date.fromisoformat(s)
        except ValueError as exc:
            raise SystemExit(
                f"Unknown period '{spec}'. Use 6h/12h/24h/48h (or any Nh), "
                "today, yesterday, week, 7d, YYYY-MM-DD, or "
                "YYYY-MM-DD..YYYY-MM-DD."
            ) from exc
        end_d = start_d + timedelta(days=1)
        label = start_d.isoformat()

    return (
        _localize_wall_time(datetime.combine(start_d, datetime.min.time()), tz),
        _localize_wall_time(datetime.combine(end_d, datetime.min.time()), tz),
        label,
    )


def ancestor_ids(session: RawSession, sessions: Dict[str, RawSession]) -> List[str]:
    out = []
    seen = {session.session_id}
    cur = session.lineage_parent()
    while cur and cur not in seen:
        seen.add(cur)
        out.append(cur)
        parent = sessions.get(cur)
        if parent is None:
            break
        cur = parent.lineage_parent()
    return out


def inherited_usage_keys(
    session: RawSession,
    sessions: Dict[str, RawSession],
) -> set:
    """
    Usage tuples present in ancestors at/before the child's creation time.

    Full-history forks/subagents can physically copy historical token_count
    events into child JSONL. Matching cumulative totals are skipped so those
    inherited counters are not billed twice locally.
    """
    keys = set()
    cutoff = session.created_at
    if cutoff is None:
        return keys
    # Small tolerance for timestamp skew around fork creation.
    cutoff = cutoff + timedelta(seconds=10)
    for aid in ancestor_ids(session, sessions):
        anc = sessions.get(aid)
        if not anc:
            continue
        for ev in anc.usage_events:
            if ev.ts <= cutoff:
                keys.add(ev.cumulative.key())
    return keys


def baseline_from_parent(
    session: RawSession,
    sessions: Dict[str, RawSession],
) -> Optional[Usage]:
    pid = session.lineage_parent()
    parent = sessions.get(pid) if pid else None
    if not parent or session.created_at is None:
        return None
    cutoff = session.created_at + timedelta(seconds=10)
    baseline = None
    for ev in parent.usage_events:
        if ev.ts <= cutoff:
            baseline = ev.cumulative
    return baseline


def compute_deltas(
    session: RawSession,
    sessions: Dict[str, RawSession],
) -> List[Tuple[datetime, str, str, Usage]]:
    inherited = inherited_usage_keys(session, sessions)
    parent_baseline = baseline_from_parent(session, sessions)
    has_parent = bool(session.lineage_parent())

    prev = Usage()
    if parent_baseline is not None:
        prev = parent_baseline

    deltas: List[Tuple[datetime, str, str, Usage]] = []
    first_usage_seen = False

    for ev in session.usage_events:
        cur = ev.cumulative

        if cur.key() in inherited:
            prev = cur
            first_usage_seen = True
            continue

        if has_parent and parent_baseline is None and not inherited and not first_usage_seen:
            prev = cur
            first_usage_seen = True
            continue

        delta = cur.minus(prev)
        prev = cur
        first_usage_seen = True
        if delta.nonzero():
            deltas.append((ev.ts, ev.model, ev.service_tier, delta))

    return deltas


def rollup_target(session: RawSession, sessions: Dict[str, RawSession], show_subagents: bool) -> str:
    if show_subagents or not session.is_subagent():
        return session.session_id

    cur = session
    seen = {cur.session_id}
    while cur.is_subagent():
        pid = cur.lineage_parent()
        if not pid or pid in seen or pid not in sessions:
            break
        seen.add(pid)
        cur = sessions[pid]
    return cur.session_id


def model_is_chatgpt_openai(session: RawSession, model: str) -> bool:
    base_model, _ = split_usage_key(model)
    provider = (session.model_provider or "").strip().lower()
    if provider and provider not in ("openai", "chatgpt"):
        return False
    return base_model in RATE_CARD


def _tier_multiplier(model: str, tier: str, assume_fast_unknown: bool) -> Tuple[float, bool]:
    """Return (multiplier, estimate_complete_for_tier)."""
    if tier == SERVICE_TIER_STANDARD:
        return 1.0, True
    if tier == SERVICE_TIER_FAST:
        multiplier = FAST_MULTIPLIERS.get(model)
        return (multiplier, True) if multiplier is not None else (1.0, False)
    if tier == SERVICE_TIER_UNKNOWN:
        if assume_fast_unknown:
            multiplier = FAST_MULTIPLIERS.get(model)
            return (multiplier, True) if multiplier is not None else (1.0, False)
        # Standard is a conservative lower bound when this model supports Fast.
        return 1.0, model not in FAST_MULTIPLIERS
    # Flex is kept distinct in reports. Until a Codex subscription credit rule
    # is embedded for it, Standard pricing is only a lower-bound diagnostic.
    return 1.0, False


def _credit_for_usage_with_completeness(
    model_key: str,
    usage: Usage,
    assume_fast_unknown: bool,
) -> Tuple[Optional[float], bool]:
    model, tier = split_usage_key(model_key)
    rate = RATE_CARD.get(model)
    if rate is None:
        return None, False
    input_rate, cached_rate, output_rate = rate
    cached = min(usage.input_tokens, usage.cached_input_tokens)
    uncached = max(0, usage.input_tokens - cached)
    multiplier, tier_complete = _tier_multiplier(model, tier, assume_fast_unknown)
    credits = (
        uncached * input_rate
        + cached * cached_rate
        + usage.output_tokens * output_rate
    ) / 1_000_000.0
    return credits * multiplier, tier_complete


def credit_for_usage(model: str, usage: Usage, fast: bool) -> Optional[float]:
    return _credit_for_usage_with_completeness(model, usage, fast)[0]


def bucket_credits(
    bucket: Bucket,
    sessions: Dict[str, RawSession],
    fast: bool,
) -> Tuple[Optional[float], bool]:
    total = 0.0
    any_priced = False
    all_complete = True
    for model_key, usage in bucket.usage_by_model.items():
        credits, complete = _credit_for_usage_with_completeness(model_key, usage, fast)
        if credits is None:
            all_complete = False
        else:
            any_priced = True
            total += credits
            all_complete = all_complete and complete
    if not any_priced:
        return None, False
    return total, all_complete


def model_map_credits(
    usage_by_model: Dict[str, Usage],
    fast: bool,
) -> Tuple[Optional[float], bool]:
    total = 0.0
    any_priced = False
    all_complete = True
    for model_key, usage in usage_by_model.items():
        credits, complete = _credit_for_usage_with_completeness(model_key, usage, fast)
        if credits is None:
            all_complete = False
        else:
            any_priced = True
            total += credits
            all_complete = all_complete and complete
    if not any_priced:
        return None, False
    return total, all_complete


def _credit_components_for_usage_with_completeness(
    model_key: str,
    usage: Usage,
    fast: bool,
) -> Tuple[Optional[Tuple[float, float, float]], bool]:
    model, tier = split_usage_key(model_key)
    rate = RATE_CARD.get(model)
    if rate is None:
        return None, False
    input_rate, cached_rate, output_rate = rate
    cached = min(usage.input_tokens, usage.cached_input_tokens)
    uncached = max(0, usage.input_tokens - cached)
    multiplier, complete = _tier_multiplier(model, tier, fast)
    return (
        uncached * input_rate * multiplier / 1_000_000.0,
        cached * cached_rate * multiplier / 1_000_000.0,
        usage.output_tokens * output_rate * multiplier / 1_000_000.0,
    ), complete


def credit_components_for_usage(
    model: str,
    usage: Usage,
    fast: bool,
) -> Optional[Tuple[float, float, float]]:
    return _credit_components_for_usage_with_completeness(model, usage, fast)[0]


def cost_components_for_map(
    usage_by_model: Dict[str, Usage],
    fast: bool,
) -> Tuple[float, float, float, bool]:
    uncached = cached = output = 0.0
    complete = True
    any_priced = False
    for model_key, usage in usage_by_model.items():
        components, entry_complete = _credit_components_for_usage_with_completeness(
            model_key, usage, fast
        )
        if components is None:
            complete = False
            continue
        any_priced = True
        uncached += components[0]
        cached += components[1]
        output += components[2]
        complete = complete and entry_complete
    return uncached, cached, output, complete and any_priced


def bucket_collection_credits(
    buckets: Dict[str, Bucket],
    sessions: Dict[str, RawSession],
    fast: bool,
) -> Tuple[Optional[float], bool]:
    total = 0.0
    any_priced = False
    complete = True
    for bucket in buckets.values():
        credits, row_complete = bucket_credits(bucket, sessions, fast)
        if credits is None:
            complete = False
            continue
        any_priced = True
        total += credits
        complete = complete and row_complete
    return (total if any_priced else None), complete and any_priced


def main_sub_maps(bucket: Bucket) -> Tuple[Dict[str, Usage], Dict[str, Usage]]:
    main_map: Dict[str, Usage] = {}
    sub_map: Dict[str, Usage] = {}
    for sid, by_model in bucket.usage_by_source.items():
        target = sub_map if sid in bucket.source_is_subagent else main_map
        for model, usage in by_model.items():
            target[model] = target.get(model, Usage()) + usage
    return main_map, sub_map


def thread_health(bucket: Bucket, fast: bool) -> str:
    # Workflow heuristic, not a quota warning. It intentionally focuses on the
    # root/main thread because that is where long-context cache tax compounds.
    main_map, _ = main_sub_maps(bucket)
    main_credits, _ = model_map_credits(main_map, fast)
    if main_credits is None:
        return "—"
    _, cache_tax, _, _ = cost_components_for_map(main_map, fast)
    main_cached = sum(u.cached_input_tokens for u in main_map.values())
    if main_credits >= 1500 and (cache_tax >= 1000 or main_cached >= 100_000_000):
        return "ROTATE"
    if main_credits >= 500 and (cache_tax >= 300 or main_cached >= 50_000_000):
        return "WATCH"
    return "OK"


def report_is_live(start: datetime, end: datetime, now: datetime) -> bool:
    # Rolling windows end at "now"; allow a little execution-time drift.
    return start <= now and end >= now - timedelta(minutes=2)


def thread_state(bucket: Bucket, now: datetime, live_report: bool) -> str:
    if not live_report:
        return "HIST"
    if bucket.last_activity is None:
        return "IDLE"
    age_min = max(0.0, (now - bucket.last_activity).total_seconds() / 60.0)
    if age_min <= ACTIVE_MINUTES:
        return "ACTIVE"
    if age_min <= RECENT_MINUTES:
        return "RECENT"
    return "IDLE"


def effective_health(bucket: Bucket, fast: bool, state: str) -> str:
    if state not in ("ACTIVE", "RECENT"):
        return "—"
    return thread_health(bucket, fast)


def recent_burn(bucket: Bucket, fast: bool) -> Tuple[Optional[float], float, bool]:
    credits, complete = model_map_credits(bucket.recent_usage_by_model, fast)
    _, cache_tax, _, _ = cost_components_for_map(bucket.recent_usage_by_model, fast)
    return credits, cache_tax, complete


def status_text(state: str, health: str, orphan: bool = False) -> str:
    if orphan:
        return "ORPHAN"
    if state in ("IDLE", "HIST"):
        return state
    return f"{state}/{health}" if health != "—" else state


def orphan_subagent(bucket: Bucket, sessions: Dict[str, RawSession]) -> bool:
    s = sessions.get(bucket.session_id)
    if not s or not s.is_subagent():
        return False
    pid = s.lineage_parent()
    return not pid or pid not in sessions


def human_tokens(n: int) -> str:
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.2f}B"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


